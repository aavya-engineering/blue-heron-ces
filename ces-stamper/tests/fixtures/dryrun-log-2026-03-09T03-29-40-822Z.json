      "subId": "SC.L2-3.13.1.nsg-deny",
      "engine": "az",
      "command": "$nsg = Get-AzNetworkSecurityGroup -ResourceGroupName '{resourceGroup}' -Name 'cmmc-nsg'; Add-AzNetworkSecurityRuleConfig -NetworkSecurityGroup $nsg -Name 'DenyAllInbound' -Protocol '*' -Direction Inbound -Priority 4096 -SourceAddressPrefix '*' -SourcePortRange '*' -DestinationAddressPrefix '*' -DestinationPortRange '*' -Access Deny | Set-AzNetworkSecurityGroup"
    },
    {
      "taskId": "STEP-SC-001",
      "label": "Create Azure Firewall Policy with Threat Intel Deny Mode",
      "subId": "SC.L2-3.13.1.firewall-policy",
      "engine": "az",
