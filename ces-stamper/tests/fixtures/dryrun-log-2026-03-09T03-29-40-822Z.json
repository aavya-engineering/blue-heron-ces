    },
    {
      "taskId": "STEP-SC-001",
      "label": "Add Management Subnet to CUI Virtual Network",
      "subId": "SC.L2-3.13.5.mgmt-subnet",
      "engine": "az",
      "command": "$vnet = Get-AzVirtualNetwork -ResourceGroupName '{resourceGroup}' -Name 'cmmc-vnet'; Add-AzVirtualNetworkSubnetConfig -Name 'management-subnet' -AddressPrefix '10.0.1.0/24' -VirtualNetwork $vnet | Set-AzVirtualNetwork"
    },
    {
      "taskId": "STEP-SC-001",
      "label": "Create Azure Key Vault with Soft Delete and Purge Protection",
      "subId": "SC.L2-3.13.10.keyvault",
      "engine": "az",
      "command": "New-AzKeyVault -ResourceGroupName '{resourceGroup}' -VaultName 'cmmc-kv-dev' -Location 'usgovvirginia' -EnablePurgeProtection -Sku Standard"
    },
