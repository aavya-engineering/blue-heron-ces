      "command": "Invoke-MgGraphRequest -Method PATCH -Uri 'https://graph.microsoft.us/v1.0/policies/authenticationMethodsPolicy/authenticationMethodConfigurations/TemporaryAccessPass' -Body (@{state='enabled';isUsableOnce=$true;defaultLifetimeInMinutes=60} | ConvertTo-Json) -ContentType 'application/json'"
