{
  "name": "ces-stamper",
  "version": "2.2.3",
  "description": "Blue Heron Defense Compliance Engine — CMMC Orchestration built for ValorForge Solutions",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/powershell": {
      "types": "./dist/adapters/PowerShellAdapter.d.ts",
      "import": "./dist/adapters/PowerShellAdapter.js"
    },
    "./registry": {
      "types": "./dist/registry/CommandRegistry.d.ts",
      "import": "./dist/registry/CommandRegistry.js"
    },
    "./types/schema": {
      "types": "./dist/types/schema.types.d.ts",
      "import": "./dist/types/schema.types.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "stamper": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-registry.cjs",
    "watch": "tsc --watch",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist",
    "stamper": "npx tsx src/cli/index.ts gui",
    "gui": "npx tsx src/cli/index.ts gui",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "keywords": [
    "cmmc",
    "compliance",
    "orchestration",
    "automation",
    "m365",
    "gcc-high"
  ],
  "author": "Blue Heron Defense, LLC",
  "builtFor": "ValorForge Solutions",
  "licenseType": "Engagement-Scoped",
  "type": "module",
  "license": "PROPRIETARY",
  "dependencies": {
    "ces-shared": "*",
    "ces-tenant": "file:../ces-tenant",
    "axios": "^1.6.2",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.0",
    "inquirer": "^8.2.6",
    "listr2": "^10.1.1",
    "open": "^8.4.0",
    "ora": "^5.4.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/inquirer": "^8.2.10",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
