# CES contractor monorepo. It is cloned to C:\ces-nb, so the runtime folders (out, pl = the harness
# pipeline root, tenants, evidence, runlogs) sit at the root and are anchored there; deeper folders with those names stay tracked.
node_modules/
dist/
/out/
/pl/
/tenants/
/evidence/
/runlogs/
.env
.env.*
!.env.example
*.pfx
*.key
