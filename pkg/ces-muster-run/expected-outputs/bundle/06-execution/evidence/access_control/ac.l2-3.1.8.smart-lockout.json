    "get_command": "$s = (Invoke-MgGraphRequest -Uri 'https://graph.microsoft.us/v1.0/groupSettings' -OutputType PSObject).value | Where-Object { $_.templateId -eq '5cf42378-d67d-4f36-ba46-e8b86229381d' } | Select-Object -First 1; if ($s) { [pscustomobject]@{ id = $s.id; templateId = $s.templateId; LockoutThreshold = (@($s.values) | Where-Object { $_.name -eq 'LockoutThreshold' } | Select-Object -First 1).value; LockoutDurationInSeconds = (@($s.values) | Where-Object { $_.name -eq 'LockoutDurationInSeconds' } | Select-Object -First 1).value; values = @(@($s.values) | ForEach-Object { [pscustomobject]@{ name = $_.name; value = $_.value } }) } | ConvertTo-Json -Depth 5 }",
    "set_command": "$LockoutThreshold=3; $LockoutDurationInSeconds=900; $s = (Invoke-MgGraphRequest -Uri 'https://graph.microsoft.us/v1.0/groupSettings' -OutputType PSObject).value | Where-Object { $_.templateId -eq '5cf42378-d67d-4f36-ba46-e8b86229381d' } | Select-Object -First 1; if (-not $s) { throw 'Password Rule Settings not found: AC.L2-3.1.8.password-rule-settings creates it' }; $vals = @(@($s.values) | Where-Object { @('LockoutThreshold','LockoutDurationInSeconds') -notcontains $_.name } | ForEach-Object { @{name=$_.name;value=[string]$_.value} }) + @(@{name='LockoutThreshold';value=[string]$LockoutThreshold},@{name='LockoutDurationInSeconds';value=[string]$LockoutDurationInSeconds}); Update-MgDirectorySetting -DirectorySettingId $s.id -Values $vals",
