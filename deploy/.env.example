# ============================================================
# CES Deployment Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- Server identity ------------------------------------------
# Your server's domain name or public IP (used in nginx config and SSL certs).
# Examples: "ces.example.com"  or  "192.168.1.100"
SERVER_HOST=your-domain-or-ip

# --- Secrets (change all of these before going to production) --
JWT_SECRET=change_me_strong_random_jwt_secret_here
CES_EO_OPERATOR_SECRET=change_me_strong_eo_operator_secret

# --- Anthropic (muster-api uses Claude) -----------------------
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# --- Tenant / scenario ----------------------------------------
TENANT_SLUG=s1-mach

# --- SSL mode -------------------------------------------------
# "self-signed"  : generate a self-signed cert (good for internal / dev use)
# "letsencrypt"  : use Let's Encrypt (requires a real public domain + port 80 open)
# "existing"     : you already placed cert.pem and key.pem in nginx/certs/
SSL_MODE=self-signed

# Let's Encrypt contact email (only needed when SSL_MODE=letsencrypt)
LETSENCRYPT_EMAIL=your@email.com
