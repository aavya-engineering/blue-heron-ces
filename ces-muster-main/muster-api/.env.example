# The application DB role MUST NOT be `postgres` and MUST NOT have BYPASSRLS.
# Using a superuser here disables all tenant isolation (RLS). Use a dedicated
# least-privilege role.
DATABASE_URL=postgresql://muster_app:password@localhost:5432/muster_db
# REQUIRED. The server throws on startup if JWT_SECRET is unset. Use a long random value.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
PORT=4000

# ── Claude API (adaptive interview + chat coach) ────────────────────────────
# Get a key at https://platform.claude.com → API keys. Without it the routes
# return 503 {degraded:true} and the SPA falls back to the static interview.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-4-8)
CLAUDE_MODEL=

# ── Tenant keys via Stamper constructs ─────────────────────────────────────
# Per-tenant Graph/auth keys are resolved from Stamper plan-data JSON files
# when ?tenant_slug= is supplied to /api/harvest/* routes. No GRAPH_TENANT_ID
# or GRAPH_CLIENT_ID needed in that path.
#
# Root of the CES pipeline storage tree. Stamper plan-data is read from
# {CES_PIPELINE_ROOT}/Stamper/plan-data/<slug>/<slug>.json.
# Default on Windows when unset: C:\CES_Pipeline
# Default on POSIX when unset:  <cwd>/ces-pipeline
CES_PIPELINE_ROOT=
#
# Set CES_STRICT_SECRETS=1 to forbid inline secrets in tenant JSON (enforce
# env: / ${VAR} references for cert_thumbprint and evidence_storage.account_key).
CES_STRICT_SECRETS=

# ── Microsoft Graph harvest (GCC High, Approach A) ─────────────────────────
# GRAPH_TENANT_ID and GRAPH_CLIENT_ID are now the NO-SLUG FALLBACK only.
# Per-tenant keys come from Stamper plan-data via ?tenant_slug= (see above).
# All three still required when no tenant_slug is supplied to /api/harvest/*.
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_TENANT_ID=
# Optional override (default: https://graph.microsoft.us/v1.0 — GCC High)
GRAPH_BASE_URL=

# ── Annuity engine ──────────────────────────────────────────────────────────
# Days since last completed session before reassessment_due (default 365)
REASSESS_DAYS=

# ── Recipe self-serve gate — LEAVE UNSET ────────────────────────────────────
# Do NOT set RECIPES_SELF_SERVE=true until concierge validation sessions are
# recorded in docs/recipes-concierge-validation.md (P2 DONE-WHEN #8 gate).
# RECIPES_SELF_SERVE=
