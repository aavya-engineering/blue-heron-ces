    {
      "id": "task_SC.L2-3.13.8",
      "type": "configuration",
      "priority": "p1",
      "depends_on": [],
      "action": {
        "engine": "powershell",
        "command": "Get-AzWebApp",
        "args": {
          "requirement_id": "SC.L2-3.13.8",
          "description": "Verify and enforce TLS 1.2+ on all web applications",
          "powershell_commands": [
            "Get-AzWebApp | Select Name,@{N='MinTls';E={$_.SiteConfig.MinTlsVersion}}",
            "Get-AzWebApp | Where {$_.SiteConfig.MinTlsVersion -lt '1.2'} | ForEach-Object { Set-AzWebApp -Name $_.Name -ResourceGroupName $_.ResourceGroup -MinTlsVersion '1.2' }"
          ],
          "portal_ref": "portal.azure.com > App Services > TLS/SSL settings",
          "service": "Azure App Service"
        }
      },
      "inputs": [],
      "outputs": ["config_SC.L2-3.13.8"],
      "controls": ["SC.L2-3.13.8"],
      "idempotency": "best_effort",
