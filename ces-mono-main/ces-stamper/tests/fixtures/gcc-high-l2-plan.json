          "powershell_commands": [
            "New-MgIdentityGovernanceLifecycleWorkflow -DisplayName 'Onboard new hire' -Category 'joiner' -ExecutionConditions @{trigger=@{type='attributeChanges';value=@{attributeName='employeeHireDate'}}} -Tasks @(@{taskDefinitionId='...';displayName='Create user account'})",
            "Get-MgIdentityGovernanceLifecycleWorkflow | Select DisplayName,Category,IsEnabled"
          ],
          "portal_ref": "entra.microsoft.com > Identity Governance > Lifecycle workflows",
          "service": "Entra ID Governance"
        }
      },
      "inputs": ["config_IA.L2-3.5.3"],
