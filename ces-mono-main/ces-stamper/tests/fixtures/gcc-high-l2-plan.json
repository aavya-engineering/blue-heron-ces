  "execution_graph": [
    {
      "id": "task_AC.L2-3.1.12",
      "type": "monitoring",
      "priority": "p0",
      "depends_on": [],
      "action": {
        "engine": "powershell",
        "command": "New-MgIdentityConditionalAccessNamedLocation",
        "args": {
          "requirement_id": "AC.L2-3.1.12",
          "description": "Configure remote access monitoring - named locations for VPN egress",
          "powershell_commands": [
            "New-MgIdentityConditionalAccessNamedLocation -DisplayName 'Corporate VPN Egress' -AdditionalProperties @{'@odata.type'='#microsoft.graph.ipNamedLocation';ipRanges=@(@{cidrAddress='203.0.113.0/24';'@odata.type'='#microsoft.graph.iPv4CidrRange'});isTrusted=$true}",
            "Get-MgIdentityConditionalAccessNamedLocation | Select DisplayName,Id | Export-Csv named_locations.csv"
          ],
          "portal_ref": "entra.microsoft.com > Protection > Conditional Access > Named locations",
          "service": "Conditional Access"
        }
      },
      "inputs": ["gap_AC.L2-3.1.12"],
      "outputs": ["config_AC.L2-3.1.12"],
      "controls": ["AC.L2-3.1.12"],
      "idempotency": "best_effort",
      "rollback": {
        "strategy": "manual",
        "notes": "Remove named location 'Corporate VPN Egress' from Conditional Access if rollback needed"
      },
      "evidence_emit": [
        {
          "artifact_id": "config_export_AC.L2-3.1.12",
          "artifact_type": "config_export",
          "description": "Conditional Access named location configuration export",
          "collector": "stamper",
          "retention_days": 365,
          "storage_location_ref": "evidence/gcc-high-l2-build-001/task_AC.L2-3.1.12"
        }
      ]
    },
    {
      "id": "task_IA.L2-3.5.3",
      "type": "configuration",
      "priority": "p0",
      "depends_on": [],
      "action": {
        "engine": "powershell",
        "command": "New-MgIdentityConditionalAccessPolicy",
        "args": {
          "requirement_id": "IA.L2-3.5.3",
          "description": "Enforce MFA for all users via Conditional Access policy",
          "powershell_commands": [
            "New-MgIdentityConditionalAccessPolicy -DisplayName 'Require MFA - All Users' -Conditions @{users=@{includeUsers=@('All')};applications=@{includeApplications=@('All')}} -GrantControls @{builtInControls=@('mfa');operator='OR'} -State 'enabled'",
            "Get-MgIdentityConditionalAccessPolicy | Where {$_.GrantControls.BuiltInControls -contains 'mfa'} | Select DisplayName,State | Export-Csv mfa_policies.csv"
          ],
          "portal_ref": "entra.microsoft.com > Protection > Conditional Access > New policy",
          "service": "Conditional Access"
        }
      },
      "inputs": ["gap_IA.L2-3.5.3"],
      "outputs": ["config_IA.L2-3.5.3"],
      "controls": ["IA.L2-3.5.3"],
      "idempotency": "safe",
      "rollback": {
        "strategy": "none",
        "notes": "MFA policy is additive and safe"
      },
      "evidence_emit": [
        {
          "artifact_id": "config_export_IA.L2-3.5.3",
          "artifact_type": "config_export",
          "description": "MFA Conditional Access policy configuration",
          "collector": "stamper",
          "retention_days": 365,
          "storage_location_ref": "evidence/gcc-high-l2-build-001/task_IA.L2-3.5.3"
        }
      ]
    },
    {
      "id": "task_AC.L1-3.1.1",
      "type": "policy",
      "priority": "p1",
      "depends_on": ["task_IA.L2-3.5.3"],
      "action": {
        "engine": "powershell",
        "command": "New-MgIdentityGovernanceLifecycleWorkflow",
