{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/ces-implementation-patterns.schema.json",
  "title": "CES Implementation Patterns Schema",
  "description": "Vendor-agnostic implementation actions for each CMMC practice. Each pattern describes WHAT to do; vendor-specific HOW lives in playbooks.",
  "type": "object",
  "required": ["ces", "patterns"],
  "additionalProperties": false,
  "properties": {
    "ces": {
      "$ref": "#/$defs/ces_meta"
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pattern"
      }
    }
  },
  "$defs": {
    "ces_meta": {
      "type": "object",
      "required": ["artifact", "version", "generated_on"],
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "type": "string",
          "const": "implementation_patterns"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "generated_on": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "pattern": {
      "type": "object",
      "required": ["practice_id", "capability", "pattern_id", "pattern_name", "actions"],
      "additionalProperties": false,
      "properties": {
        "practice_id": {
          "type": "string",
          "minLength": 1,
          "description": "CMMC practice ID or FOUNDATION"
        },
        "capability": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$",
          "description": "Capability ID from the taxonomy"
        },
        "pattern_id": {
          "type": "string",
          "pattern": "^[A-Z]{2,4}-\\d{3}$",
          "description": "Unique pattern identifier (e.g. IAM-001)"
        },
        "pattern_name": {
          "type": "string",
          "minLength": 1
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      }
    },
    "action": {
      "type": "object",
      "required": ["id", "action", "action_type", "evidence_outputs"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{2,4}-\\d{3}-\\d{2}$",
          "description": "Unique action identifier (e.g. IAM-001-01)"
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "description": "What to do (vendor-agnostic)"
        },
        "action_type": {
          "$ref": "#/$defs/action_type_enum"
        },
        "evidence_outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]+$",
            "description": "Evidence archetype identifier"
          }
        }
      }
    },
    "action_type_enum": {
      "type": "string",
      "enum": ["policy", "configuration", "process", "monitoring", "training", "assessment"]
    }
  }
}