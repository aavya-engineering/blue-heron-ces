{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/ces-sit-question-bank.schema.json",
  "title": "CES SIT Question Bank (CMMC 2.0) Schema",
  "type": "object",
  "required": [
    "ces"
  ],
  "additionalProperties": false,
  "properties": {
    "ces": {
      "type": "object",
      "required": [
        "artifact",
        "version",
        "generated_on",
        "intent",
        "authoritative_sources",
        "governance",
        "its_fields",
        "question_bank",
        "scoping_asset_categories",
        "level_specific",
        "gates",
        "sit_completion"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "generated_on": {
          "type": "string",
          "format": "date"
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "authoritative_sources": {
          "type": "object",
          "required": [
            "government"
          ],
          "additionalProperties": false,
          "properties": {
            "government": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "title",
                  "url"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9_\\-]+$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              },
              "uniqueItems": true
            }
          }
        },
        "governance": {
          "type": "object",
          "required": [
            "non_negotiables",
            "provenance_rules"
          ],
          "additionalProperties": false,
          "properties": {
            "non_negotiables": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "provenance_rules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "class",
                  "required_sources"
                ],
                "additionalProperties": false,
                "properties": {
                  "class": {
                    "type": "string",
                    "minLength": 1
                  },
                  "required_sources": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        "its_fields": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          }
        },
        "question_bank": {
          "type": "object",
          "required": [
            "universal"
          ],
          "additionalProperties": false,
          "properties": {
            "universal": {
              "type": "object",
              "required": [
                "description",
                "questions"
              ],
              "additionalProperties": false,
              "properties": {
                "description": {
                  "type": "string"
                },
                "questions": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/question"
                  }
                }
              }
            }
          }
        },
        "scoping_asset_categories": {
          "type": "object",
          "required": [
            "description",
            "questions"
          ],
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string"
            },
            "questions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/question"
              }
            }
          }
        },
        "level_specific": {
          "type": "object",
          "required": [
            "description",
            "L1",
            "L2",
            "L3"
          ],
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string"
            },
            "L1": {
              "$ref": "#/$defs/level_block"
            },
            "L2": {
              "$ref": "#/$defs/level_block"
            },
            "L3": {
              "$ref": "#/$defs/level_block"
            }
          }
        },
        "gates": {
          "type": "object",
          "required": [
            "description",
            "checks"
          ],
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string"
            },
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/gate_check"
              }
            }
          }
        },
        "sit_completion": {
          "type": "object",
          "required": [
            "definition",
            "outputs_to_rrt"
          ],
          "additionalProperties": false,
          "properties": {
            "definition": {
              "type": "string",
              "minLength": 1
            },
            "outputs_to_rrt": {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "sit_field_id",
                      "rrt_input_key",
                      "binding_strength"
                    ],
                    "properties": {
                      "sit_field_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "rrt_input_key": {
                        "type": "string",
                        "minLength": 1
                      },
                      "binding_strength": {
                        "type": "string",
                        "enum": [
                          "hard",
                          "soft"
                        ]
                      },
                      "notes": {
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}