{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/ces-assessor-evidence-matrix.schema.json",
  "title": "CES Assessor Evidence Matrix (CMMC 2.0) Schema",
  "type": "object",
  "required": [
    "ces",
    "evidence_archetypes_catalog",
    "domain_defaults",
    "requirement_matrix"
  ],
  "additionalProperties": false,
  "properties": {
    "ces": {
      "$ref": "#/$defs/ces_meta"
    },
    "evidence_archetypes_catalog": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "domain_defaults": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "methods_default",
          "evidence_default",
          "common_tests",
          "design_for_assessment"
        ],
        "additionalProperties": false,
        "properties": {
          "methods_default": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/method_enum"
            }
          },
          "evidence_default": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "common_tests": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "design_for_assessment": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "requirement_matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requirement_entry"
      }
    }
  },
  "$defs": {
    "method_enum": {
      "type": "string",
      "enum": [
        "examine",
        "interview",
        "test"
      ]
    },
    "tag_enum": {
      "type": "string",
      "enum": [
        "FACT",
        "INFERENCE",
        "OPEN_QUESTION"
      ]
    },
    "ces_meta": {
      "type": "object",
      "required": [
        "artifact",
        "version",
        "generated_on",
        "intent",
        "authoritative_sources",
        "governance"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "generated_on": {
          "type": "string",
          "format": "date"
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "authoritative_sources": {
          "type": "object",
          "required": [
            "government"
          ],
          "additionalProperties": false,
          "properties": {
            "government": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "title",
                  "url"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9_\\-]+$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            }
          }
        },
        "governance": {
          "type": "object",
          "required": [
            "non_negotiables",
            "tagging_policy"
          ],
          "additionalProperties": false,
          "properties": {
            "non_negotiables": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "tagging_policy": {
              "type": "object",
              "required": [
                "allowed_tags",
                "rules"
              ],
              "additionalProperties": false,
              "properties": {
                "allowed_tags": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/tag_enum"
                  }
                },
                "rules": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "requirement_entry": {
      "type": "object",
      "required": [
        "requirement_id",
        "level",
        "domain",
        "assessor_methods",
        "evidence_archetypes",
        "common_tests",
        "design_for_assessment",
        "tag",
        "source_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "type": "string",
          "pattern": "^[A-Z]{2}\\.L[123]\\-[A-Za-z0-9\\.\\-]+$"
        },
        "level": {
          "type": "string",
          "enum": [
            "L1",
            "L2",
            "L3"
          ]
        },
        "domain": {
          "type": "string",
          "enum": [
            "AC",
            "AT",
            "AU",
            "CA",
            "CM",
            "IA",
            "IR",
            "MA",
            "MP",
            "PE",
            "PS",
            "RA",
            "SC",
            "SI"
          ]
        },
        "assessor_methods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/method_enum"
          }
        },
        "evidence_archetypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "common_tests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "design_for_assessment": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tag": {
          "$ref": "#/$defs/tag_enum"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}