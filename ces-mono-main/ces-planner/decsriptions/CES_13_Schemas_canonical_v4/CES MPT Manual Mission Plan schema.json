{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/ces-mpt-manual-mission-plan.schema.json",
  "title": "CES Manual Mission Plan (MPT) Schema",
  "type": "object",
  "required": [
    "ces",
    "inputs",
    "outputs"
  ],
  "additionalProperties": false,
  "properties": {
    "ces": {
      "type": "object",
      "required": [
        "artifact",
        "version",
        "generated_on",
        "intent"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "type": "string",
          "const": "manual_mission_plan"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "generated_on": {
          "type": "string",
          "format": "date"
        },
        "intent": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "inputs": {
      "$ref": "#/$defs/inputs_block",
      "properties": {
        "si_baseline_ref": {
          "$ref": "#/$defs/artifact_ref"
        },
        "readiness_posture_ref": {
          "$ref": "#/$defs/artifact_ref"
        }
      }
    },
    "outputs": {
      "$ref": "#/$defs/outputs_block"
    }
  },
  "$defs": {
    "level_enum": {
      "type": "string",
      "enum": [
        "L1",
        "L2",
        "L3"
      ]
    },
    "priority_enum": {
      "type": "string",
      "enum": [
        "p0",
        "p1",
        "p2",
        "p3"
      ]
    },
    "plan_mode_enum": {
      "type": "string",
      "enum": [
        "build_new",
        "harden_existing",
        "migrate",
        "hybrid"
      ]
    },
    "support_type_enum": {
      "type": "string",
      "enum": [
        "Overt",
        "Configurable",
        "Inherited",
        "Partial",
        "None"
      ]
    },
    "task_type_enum": {
      "type": "string",
      "enum": [
        "configure",
        "deploy",
        "integrate",
        "document",
        "train",
        "operate",
        "verify",
        "remediate"
      ]
    },
    "artifact_type_enum": {
      "type": "string",
      "enum": [
        "policy",
        "procedure",
        "ssp",
        "diagram",
        "config_export",
        "log_export",
        "ticket_export",
        "training_record",
        "scan_report",
        "attestation",
        "other"
      ]
    },
    "source_ref": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "type": {
          "type": "string",
          "enum": [
            "government",
            "nist",
            "vendor",
            "internal"
          ]
        },
        "version": {
          "type": "string"
        },
        "published_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "inputs_block": {
      "type": "object",
      "required": [
        "si_baseline",
        "readiness_posture",
        "authoritative_sources",
        "vendor_capability_packages",
        "assessor_knowledge"
      ],
      "additionalProperties": false,
      "properties": {
        "si_baseline": {
          "type": "object",
          "additionalProperties": true
        },
        "readiness_posture": {
          "type": "object",
          "required": [
            "snapshot_id",
            "as_of_date",
            "control_status_summary",
            "key_findings",
            "constraints"
          ],
          "additionalProperties": false,
          "properties": {
            "snapshot_id": {
              "type": "string",
              "minLength": 1
            },
            "as_of_date": {
              "type": "string",
              "format": "date"
            },
            "control_status_summary": {
              "type": "object",
              "required": [
                "level",
                "met",
                "partial",
                "not_met",
                "unknown"
              ],
              "additionalProperties": false,
              "properties": {
                "level": {
                  "$ref": "#/$defs/level_enum"
                },
                "met": {
                  "type": "integer",
                  "minimum": 0
                },
                "partial": {
                  "type": "integer",
                  "minimum": 0
                },
                "not_met": {
                  "type": "integer",
                  "minimum": 0
                },
                "unknown": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "key_findings": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/finding"
              }
            },
            "constraints": {
              "type": "object",
              "required": [
                "time",
                "budget",
                "tooling",
                "staffing"
              ],
              "additionalProperties": false,
              "properties": {
                "time": {
                  "type": "string"
                },
                "budget": {
                  "type": "string"
                },
                "tooling": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "staffing": {
                  "type": "string"
                }
              }
            }
          }
        },
        "authoritative_sources": {
          "type": "object",
          "required": [
            "government",
            "nist"
          ],
          "additionalProperties": false,
          "properties": {
            "government": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/source_ref"
              }
            },
            "nist": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/source_ref"
              }
            },
            "assessor_guides": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_ref"
              }
            }
          }
        },
        "vendor_capability_packages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "tech_stack_id",
              "name",
              "vendor",
              "fedramp_level",
              "package_ref"
            ],
            "additionalProperties": false,
            "properties": {
              "tech_stack_id": {
                "type": "integer",
                "minimum": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "vendor": {
                "type": "string",
                "minLength": 1
              },
              "fedramp_level": {
                "type": "string",
                "minLength": 1
              },
              "package_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "assessor_knowledge": {
          "type": "object",
          "required": [
            "assessor_approach_ref",
            "assessor_evidence_matrix_ref",
            "design_for_assessment_rules"
          ],
          "additionalProperties": false,
          "properties": {
            "assessor_approach_ref": {
              "type": "string",
              "minLength": 1
            },
            "assessor_evidence_matrix_ref": {
              "type": "string",
              "minLength": 1
            },
            "design_for_assessment_rules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/dfa_rule"
              }
            }
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "control_id",
        "title",
        "status",
        "severity",
        "evidence_gaps",
        "recommended_actions"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "control_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "MET",
            "PARTIAL",
            "NOT_MET",
            "UNKNOWN"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "evidence_gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recommended_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dfa_rule": {
      "type": "object",
      "required": [
        "id",
        "title",
        "rule",
        "verification",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "outputs_block": {
      "type": "object",
      "required": [
        "human_readable_mission_plan",
        "cost_proposal_sow",
        "tenant_manifest"
      ],
      "additionalProperties": false,
      "properties": {
        "human_readable_mission_plan": {
          "$ref": "#/$defs/human_plan"
        },
        "cost_proposal_sow": {
          "$ref": "#/$defs/cost_proposal"
        },
        "tenant_manifest": {
          "$ref": "#/$defs/tenant_manifest"
        }
      }
    },
    "human_plan": {
      "type": "object",
      "required": [
        "plan_id",
        "plan_mode",
        "target_level",
        "milestones",
        "steps",
        "assessor_alignment_notes"
      ],
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "type": "string",
          "minLength": 1
        },
        "plan_mode": {
          "$ref": "#/$defs/plan_mode_enum"
        },
        "target_level": {
          "$ref": "#/$defs/level_enum"
        },
        "milestones": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/milestone"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/manual_step"
          }
        },
        "assessor_alignment_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "milestone": {
      "type": "object",
      "required": [
        "id",
        "name",
        "objective",
        "exit_criteria",
        "target_date"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "exit_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "manual_step": {
      "type": "object",
      "required": [
        "id",
        "title",
        "task_type",
        "priority",
        "control_coverage",
        "what_to_do",
        "how_to_verify",
        "vendor_help_refs",
        "expected_artifacts",
        "manual_completion_criteria"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "task_type": {
          "$ref": "#/$defs/task_type_enum"
        },
        "priority": {
          "$ref": "#/$defs/priority_enum"
        },
        "control_coverage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/control_coverage"
          }
        },
        "what_to_do": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "how_to_verify": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "vendor_help_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vendor_help_ref"
          }
        },
        "expected_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_artifact"
          }
        },
        "manual_completion_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Explicit checklist items used by implementers/reviewer to mark the step complete."
        },
        "owner_role": {
          "type": "string"
        },
        "estimated_effort_hours": {
          "type": "number",
          "minimum": 0
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "control_coverage": {
      "type": "object",
      "required": [
        "control_id",
        "support_type",
        "gap_rationale"
      ],
      "additionalProperties": false,
      "properties": {
        "control_id": {
          "type": "string",
          "minLength": 1
        },
        "support_type": {
          "$ref": "#/$defs/support_type_enum"
        },
        "gap_rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "vendor_help_ref": {
      "type": "object",
      "required": [
        "vendor",
        "product",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "path_hint": {
          "type": "string"
        }
      }
    },
    "evidence_artifact": {
      "type": "object",
      "required": [
        "artifact_id",
        "artifact_type",
        "description",
        "collector",
        "retention_days",
        "storage_location_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_type": {
          "$ref": "#/$defs/artifact_type_enum"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "collector": {
          "type": "string",
          "minLength": 1
        },
        "retention_days": {
          "type": "integer",
          "minimum": 0
        },
        "storage_location_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cost_proposal": {
      "type": "object",
      "required": [
        "proposal_id",
        "assumptions",
        "line_items",
        "sow"
      ],
      "additionalProperties": false,
      "properties": {
        "proposal_id": {
          "type": "string",
          "minLength": 1
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "line_items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/price_line"
          }
        },
        "sow": {
          "$ref": "#/$defs/sow"
        }
      }
    },
    "price_line": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type",
        "qty",
        "unit",
        "unit_price",
        "extended_price",
        "mapping"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "labor",
            "license",
            "service",
            "hardware",
            "other"
          ]
        },
        "qty": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "unit_price": {
          "type": "number",
          "minimum": 0
        },
        "extended_price": {
          "type": "number",
          "minimum": 0
        },
        "mapping": {
          "type": "object",
          "required": [
            "milestones",
            "steps",
            "controls"
          ],
          "additionalProperties": false,
          "properties": {
            "milestones": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "controls": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "sow": {
      "type": "object",
      "required": [
        "statement_of_work",
        "deliverables",
        "acceptance_criteria",
        "out_of_scope",
        "customer_dependencies"
      ],
      "additionalProperties": false,
      "properties": {
        "statement_of_work": {
          "type": "string",
          "minLength": 1
        },
        "deliverables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "customer_dependencies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tenant_manifest": {
      "type": "object",
      "required": [
        "manifest_id",
        "tech_stack_id",
        "normative_controls",
        "assets",
        "config_intents",
        "evidence_monitors",
        "drift_policies"
      ],
      "additionalProperties": false,
      "properties": {
        "manifest_id": {
          "type": "string",
          "minLength": 1
        },
        "tech_stack_id": {
          "type": "integer",
          "minimum": 1
        },
        "normative_controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/normative_control"
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          }
        },
        "config_intents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/config_intent"
          }
        },
        "evidence_monitors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_monitor"
          }
        },
        "drift_policies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/drift_policy"
          }
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "id",
        "description",
        "method",
        "expected",
        "on_fail"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "enum": [
            "api_query",
            "config_export",
            "log_query",
            "manual_attestation"
          ]
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "on_fail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "normative_control": {
      "type": "object",
      "required": [
        "control_id",
        "required_state",
        "verification",
        "evidence_artifacts"
      ],
      "additionalProperties": false,
      "properties": {
        "control_id": {
          "type": "string",
          "minLength": 1
        },
        "required_state": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "evidence_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_artifact"
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "required": [
        "asset_id",
        "asset_type",
        "scope_category",
        "tags"
      ],
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "asset_type": {
          "type": "string",
          "minLength": 1
        },
        "scope_category": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "owner": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "config_intent": {
      "type": "object",
      "required": [
        "id",
        "title",
        "control_ids",
        "desired_config",
        "source_of_truth",
        "query_method"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "control_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
