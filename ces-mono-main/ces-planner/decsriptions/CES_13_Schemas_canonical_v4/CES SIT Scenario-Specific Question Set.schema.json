{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/ces-rr-question-set-output.schema.json",
  "title": "CES Scenario-Specific RR Question Set Output Schema",
  "type": "object",
  "required": [
    "ces"
  ],
  "additionalProperties": false,
  "properties": {
    "ces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "version",
        "generated_on",
        "intent",
        "inputs",
        "scenario",
        "selection",
        "questions",
        "coverage"
      ],
      "properties": {
        "artifact": {
          "const": "CES_RR_QUESTION_SET"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "generated_on": {
          "type": "string",
          "format": "date-time"
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "si_baseline_ref",
            "rrt_bank_ref",
            "cmmc_requirements_ref",
            "assessor_evidence_matrix_ref",
            "assessor_approach_ref",
            "vendor_capabilities_ref"
          ],
          "properties": {
            "si_baseline_ref": {
              "$ref": "#/$defs/artifact_ref"
            },
            "rrt_bank_ref": {
              "$ref": "#/$defs/artifact_ref"
            },
            "cmmc_requirements_ref": {
              "$ref": "#/$defs/artifact_ref"
            },
            "assessor_evidence_matrix_ref": {
              "$ref": "#/$defs/artifact_ref"
            },
            "assessor_approach_ref": {
              "$ref": "#/$defs/artifact_ref"
            },
            "vendor_capabilities_ref": {
              "$ref": "#/$defs/artifact_ref"
            }
          }
        },
        "scenario": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scenario_id",
            "tags",
            "derivation_rules_version"
          ],
          "properties": {
            "scenario_id": {
              "type": "string",
              "minLength": 1
            },
            "tags": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "derivation_rules_version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selected_activity_ids",
            "excluded_activity_ids"
          ],
          "properties": {
            "selected_activity_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "excluded_activity_ids": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "activity_id",
                  "reason"
                ],
                "properties": {
                  "activity_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rr_question"
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requirements_covered",
            "requirements_missing"
          ],
          "properties": {
            "requirements_covered": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "requirements_missing": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "requirement_id",
                  "reason"
                ],
                "properties": {
                  "requirement_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "artifact_id",
        "version",
        "hash_sha256"
      ],
      "properties": {
        "schema_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "hash_sha256": {
          "type": "string",
          "minLength": 16
        }
      }
    },
    "assessor_method": {
      "type": "string",
      "enum": [
        "examine",
        "interview",
        "test"
      ]
    },
    "rr_question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "prompt",
        "answer_type",
        "priority",
        "source_activity_id",
        "produces_rrt_fields",
        "mapped_requirements",
        "assessor_methods",
        "expected_evidence"
      ],
      "properties": {
        "question_id": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "answer_type": {
          "type": "string",
          "enum": [
            "yes_no",
            "enum",
            "multi_select",
            "free_text",
            "evidence_upload",
            "url",
            "structured_json"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "source_activity_id": {
          "type": "string",
          "minLength": 1
        },
        "produces_rrt_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mapped_requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assessor_methods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assessor_method"
          }
        },
        "expected_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_matrix_id",
              "archetype_id",
              "minimum_fields"
            ],
            "properties": {
              "evidence_matrix_id": {
                "type": "string",
                "minLength": 1
              },
              "archetype_id": {
                "type": "string",
                "minLength": 1
              },
              "minimum_fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "retention_days_min": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "si_triggers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "si_field_id",
              "reason"
            ],
            "properties": {
              "si_field_id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}