{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/ces-readiness-posture-output.schema.json",
  "title": "CES Readiness Posture Output Schema",
  "type": "object",
  "required": [
    "ces"
  ],
  "additionalProperties": false,
  "properties": {
    "ces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "version",
        "generated_on",
        "snapshot_id",
        "as_of_date",
        "si_baseline_ref",
        "rr_question_set_ref",
        "control_status_summary",
        "key_findings",
        "constraints",
        "requirement_results",
        "evidence_index"
      ],
      "properties": {
        "artifact": {
          "const": "CES_READINESS_POSTURE"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "generated_on": {
          "type": "string",
          "format": "date-time"
        },
        "cesId": {
          "type": "string",
          "pattern": "^ces-[0-9a-f]{12}$",
          "description": "Globally unique CES ID linking artifact to customer + SI baseline"
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "as_of_date": {
          "type": "string",
          "format": "date"
        },
        "si_baseline_ref": {
          "$ref": "#/$defs/artifact_ref"
        },
        "rr_question_set_ref": {
          "$ref": "#/$defs/artifact_ref"
        },
        "control_status_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "met",
            "partial",
            "not_met",
            "unknown"
          ],
          "properties": {
            "level": {
              "type": "string",
              "minLength": 1
            },
            "met": {
              "type": "integer",
              "minimum": 0
            },
            "partial": {
              "type": "integer",
              "minimum": 0
            },
            "not_met": {
              "type": "integer",
              "minimum": 0
            },
            "unknown": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "key_findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requirement_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requirement_id",
              "status",
              "evidence_refs"
            ],
            "properties": {
              "requirement_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "met",
                  "partial",
                  "not_met",
                  "unknown"
                ]
              },
              "notes": {
                "type": "string"
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidence_ref"
                }
              }
            }
          }
        },
        "evidence_index": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_id",
              "source_system",
              "location",
              "hash_sha256"
            ],
            "properties": {
              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "source_system": {
                "type": "string",
                "minLength": 1
              },
              "location": {
                "type": "string",
                "minLength": 1
              },
              "hash_sha256": {
                "type": "string",
                "minLength": 16
              },
              "captured_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "artifact_id",
        "version",
        "hash_sha256"
      ],
      "properties": {
        "schema_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "hash_sha256": {
          "type": "string",
          "minLength": 16
        }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "statement"
      ],
      "properties": {
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "impacts_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recommended_next_step_tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}