{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/ces-mpt-manual-mission-plan.schema.json",
  "title": "CES Manual Mission Plan (MPT) Schema",
  "type": "object",
  "required": [
    "ces",
    "inputs",
    "outputs"
  ],
  "additionalProperties": false,
  "properties": {
    "ces": {
      "type": "object",
      "required": [
        "artifact",
        "version",
        "generated_on",
        "intent"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "type": "string",
          "const": "manual_mission_plan"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "generated_on": {
          "type": "string",
          "format": "date"
        },
        "intent": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "inputs": {
      "$ref": "#/$defs/inputs_block",
      "properties": {
        "si_baseline_ref": {
          "$ref": "#/$defs/artifact_ref"
        },
        "readiness_posture_ref": {
          "$ref": "#/$defs/artifact_ref"
        }
      }
    },
    "outputs": {
      "$ref": "#/$defs/outputs_block"
    }
  },
  "$defs": {
    "level_enum": {
      "type": "string",
      "enum": [
        "L1",
        "L2",
        "L3"
      ]
    },
    "priority_enum": {
      "type": "string",
      "enum": [
        "p0",
        "p1",
        "p2",
        "p3"
      ]
    },
    "plan_mode_enum": {
      "type": "string",
      "enum": [
        "build_new",
        "harden_existing",
        "migrate",
        "hybrid"
      ]
    },
    "support_type_enum": {
      "type": "string",
      "enum": [
        "Overt",
        "Configurable",
        "Inherited",
        "Partial",
        "None"
      ]
    },
    "task_type_enum": {
      "type": "string",
      "enum": [
        "policy",
        "configuration",
        "process",
        "monitoring",
        "training",
        "assessment",
        "evidence_collection"
      ]
    },
    "artifact_type_enum": {
      "type": "string",
      "enum": [
        "policy",
        "procedure",
        "ssp",
        "diagram",
        "config_export",
        "log_export",
        "ticket_export",
        "training_record",
        "scan_report",
        "other"
      ]
    },
    "source_ref": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "type": {
          "type": "string",
          "enum": [
            "government",
            "nist",
            "vendor",
            "internal"
          ]
        },
        "version": {
          "type": "string"
        },
        "published_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "inputs_block": {
      "type": "object",
      "required": [
        "si_baseline",
        "readiness_posture",
        "authoritative_sources",
        "vendor_capability_packages",
        "assessor_knowledge"
      ],
      "additionalProperties": false,
      "properties": {
        "si_baseline": {
          "type": "object",
          "additionalProperties": true
        },
        "readiness_posture": {
          "type": "object",
          "required": [
            "snapshot_id",
            "as_of_date",
            "control_status_summary",
            "key_findings",
            "constraints"
          ],
          "additionalProperties": false,
          "properties": {
            "snapshot_id": {
              "type": "string",
              "minLength": 1
            },
            "as_of_date": {
              "type": "string",
              "format": "date"
            },
            "control_status_summary": {
              "type": "object",
              "required": [
                "level",
                "met",
                "partial",
                "not_met",
                "unknown"
              ],
              "additionalProperties": false,
              "properties": {
                "level": {
                  "$ref": "#/$defs/level_enum"
                },
                "met": {
                  "type": "integer",
                  "minimum": 0
                },
                "partial": {
                  "type": "integer",
                  "minimum": 0
                },
                "not_met": {
                  "type": "integer",
                  "minimum": 0
                },
                "unknown": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "key_findings": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/finding"
              }
            },
            "constraints": {
              "type": "object",
              "required": [
                "time",
                "budget",
                "tooling",
                "staffing"
              ],
              "additionalProperties": false,
              "properties": {
                "time": {
                  "type": "string"
                },
                "budget": {
                  "type": "string"
                },
                "tooling": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "staffing": {
                  "type": "string"
                }
              }
            }
          }
        },
        "authoritative_sources": {
          "type": "object",
          "required": [
            "government",
            "nist"
          ],
          "additionalProperties": false,
          "properties": {
            "government": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/source_ref"
              }
            },
            "nist": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/source_ref"
              }
            },
            "assessor_guides": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source_ref"
              }
            }
          }
        },
        "vendor_capability_packages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "tech_stack_id",
              "name",
              "vendor",
              "fedramp_level",
              "package_ref"
            ],
            "additionalProperties": false,
            "properties": {
              "tech_stack_id": {
                "type": "integer",
                "minimum": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "vendor": {
                "type": "string",
                "minLength": 1
              },
              "fedramp_level": {
                "type": "string",
                "minLength": 1
              },
              "package_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "assessor_knowledge": {
          "type": "object",
          "required": [
            "assessor_approach_ref",
            "assessor_evidence_matrix_ref",
            "design_for_assessment_rules"
          ],
          "additionalProperties": false,
          "properties": {
            "assessor_approach_ref": {
              "type": "string",
              "minLength": 1
            },
            "assessor_evidence_matrix_ref": {
              "type": "string",
              "minLength": 1
            },
            "design_for_assessment_rules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/dfa_rule"
              }
            }
          }
        },
        "cui_boundary_ref": {
          "type": "object",
          "description": "Reference to the CUI boundary artifact used as input.",
          "additionalProperties": true
        },
        "btc_confirmation_ref": {
          "type": "object",
          "description": "Reference to the BTC confirmation artifact used as input.",
          "additionalProperties": true
        },
        "tcp_ref": {
          "type": "object",
          "description": "Reference to the Tenant Config Profile artifact used as input.",
          "additionalProperties": true
        },
        "infrastructure_manifest_ref": {
          "type": "object",
          "description": "Reference to the Infrastructure Manifest artifact used as input for infra deployment steps.",
          "additionalProperties": true
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "control_id",
        "title",
        "status",
        "severity",
        "evidence_gaps",
        "recommended_actions"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "control_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "MET",
            "PARTIAL",
            "NOT_MET",
            "UNKNOWN"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "evidence_gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recommended_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "root_cause_hypothesis": {
          "type": "string",
          "description": "Hypothesized root cause for the finding."
        }
      }
    },
    "dfa_rule": {
      "type": "object",
      "required": [
        "id",
        "title",
        "rule",
        "verification",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assessor_method_alignment": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["examine", "interview", "test"]
          },
          "description": "Assessor methods this rule aligns with."
        }
      }
    },
    "outputs_block": {
      "type": "object",
      "required": [
        "human_readable_mission_plan",
        "cost_proposal_sow",
        "tenant_manifest"
      ],
      "additionalProperties": false,
      "properties": {
        "human_readable_mission_plan": {
          "$ref": "#/$defs/human_plan"
        },
        "cost_proposal_sow": {
          "$ref": "#/$defs/cost_proposal"
        },
        "tenant_manifest": {
          "$ref": "#/$defs/tenant_manifest"
        }
      }
    },
    "human_plan": {
      "type": "object",
      "required": [
        "plan_id",
        "plan_mode",
        "target_level",
        "milestones",
        "assessor_alignment_notes"
      ],
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "type": "string",
          "minLength": 1
        },
        "plan_mode": {
          "$ref": "#/$defs/plan_mode_enum"
        },
        "target_level": {
          "$ref": "#/$defs/level_enum"
        },
        "milestones": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/milestone"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/manual_step"
          }
        },
        "assessor_alignment_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "boundary_context": {
          "type": "object",
          "description": "CUI boundary and BTC verification context for the plan.",
          "additionalProperties": true
        },
        "scope_exclusions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scope_exclusion"
          },
          "description": "Controls excluded from scope with justification."
        },
        "control_directives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/control_directive"
          },
          "description": "Per-control directives declaring intent for all 110 CMMC L2 controls."
        }
      }
    },
    "milestone": {
      "type": "object",
      "required": [
        "id",
        "name",
        "objective",
        "exit_criteria",
        "target_date"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "exit_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target_date": {
          "type": "string",
          "format": "date"
        },
        "phase_tasks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Task IDs assigned to this milestone phase."
        }
      }
    },
    "manual_step": {
      "type": "object",
      "required": [
        "id",
        "title",
        "task_type",
        "priority",
        "control_coverage",
        "what_to_do",
        "how_to_verify",
        "vendor_help_refs",
        "expected_artifacts",
        "manual_completion_criteria"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "task_type": {
          "$ref": "#/$defs/task_type_enum"
        },
        "priority": {
          "$ref": "#/$defs/priority_enum"
        },
        "control_coverage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/control_coverage"
          }
        },
        "what_to_do": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "how_to_verify": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "vendor_help_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vendor_help_ref"
          }
        },
        "expected_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_artifact"
          }
        },
        "manual_completion_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Explicit checklist items used by implementers/reviewer to mark the step complete."
        },
        "owner_role": {
          "type": "string"
        },
        "estimated_effort_hours": {
          "type": "number",
          "minimum": 0
        },
        "effort_estimate": {
          "type": "object",
          "properties": {
            "one_time_dev_loe": { "type": "number", "minimum": 0 },
            "one_time_config_manual": { "type": "number", "minimum": 0 },
            "one_time_config_automated": { "type": "number", "minimum": 0 },
            "recurring_evidence_manual": { "type": "number", "minimum": 0 },
            "recurring_evidence_automated": { "type": "number", "minimum": 0 }
          },
          "required": ["one_time_dev_loe", "one_time_config_manual", "one_time_config_automated", "recurring_evidence_manual", "recurring_evidence_automated"],
          "additionalProperties": false
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step_action"
          }
        },
        "notes": {
          "type": "string"
        },
        "gap_classifications": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["configure", "customize", "manual", "auto_generate"]
          },
          "description": "Gap classifications driving the remediation approach for this step."
        },
        "requirement_context": {
          "type": "object",
          "description": "CMMC requirement context for display purposes.",
          "properties": {
            "title": { "type": "string" },
            "requirement_text": { "type": "string" },
            "domain": { "type": "string" },
            "level": { "type": "string" },
            "nist_reference": { "type": "string" }
          },
          "additionalProperties": false
        },
        "section": {
          "type": "string",
          "description": "Infrastructure section name.",
          "enum": ["identity", "logging", "security", "storage", "network", "automation", "diagnostics"]
        },
        "resource_type": {
          "type": "string",
          "description": "Azure resource type (e.g. key_vault, storage_account)."
        },
        "layer": {
          "type": "integer",
          "minimum": 0,
          "description": "DAG-computed deployment layer."
        },
        "tech_ref": {
          "type": "object",
          "description": "Structured Microsoft tech ref implementation guidance per task.",
          "additionalProperties": false,
          "properties": {
            "assessment_objectives": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "text": { "type": "string" }
                },
                "required": ["id", "text"],
                "additionalProperties": false
              }
            },
            "nist_mapping": {
              "type": "string",
              "description": "Combined NIST SP 800-171 and 800-53 reference string."
            },
            "implementation_by_service": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "service_name": { "type": "string" },
                  "paragraphs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "text": { "type": "string" },
                        "text_with_links": { "type": "string" },
                        "links": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "text": { "type": "string" },
                              "url": { "type": "string" }
                            },
                            "required": ["text", "url"],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": ["text", "text_with_links", "links"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": ["service_name", "paragraphs"],
                "additionalProperties": false
              }
            },
            "gcch_responsibilities": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": { "type": "string" },
                  "text_with_links": { "type": "string" }
                },
                "required": ["text", "text_with_links"],
                "additionalProperties": false
              }
            },
            "evidence_guidance": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "assessor_methods": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "archetypes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "archetype_id": { "type": "string" },
                      "name": { "type": "string" },
                      "strength": { "type": "string" },
                      "strength_examples": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "strength": { "type": "string" },
                            "description": { "type": "string" }
                          },
                          "required": ["strength", "description"],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": ["archetype_id", "name", "strength", "strength_examples"],
                    "additionalProperties": false
                  }
                },
                "anti_patterns": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "required": ["assessor_methods", "archetypes", "anti_patterns"]
            }
          },
          "required": ["assessment_objectives", "nist_mapping", "implementation_by_service", "gcch_responsibilities"]
        }
      }
    },
    "step_action": {
      "type": "object",
      "required": ["action_id", "action", "action_type", "evidence_outputs"],
      "additionalProperties": false,
      "properties": {
        "action_id": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "action_type": { "type": "string", "minLength": 1 },
        "evidence_outputs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "vendor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "m365_service": { "type": "string" },
            "implementation": { "type": "string" },
            "portal_path": { "type": "string" },
            "powershell": { "type": "array", "items": { "type": "string" } },
            "evidence_commands": { "type": "array", "items": { "type": "string" } },
            "notes": { "type": "string" },
            "tech_ref_guidance": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Per-service tech ref guidance paragraphs (text_with_links)."
            }
          }
        }
      }
    },
    "control_coverage": {
      "type": "object",
      "required": [
        "control_id",
        "support_type",
        "gap_rationale"
      ],
      "additionalProperties": false,
      "properties": {
        "control_id": {
          "type": "string",
          "minLength": 1
        },
        "support_type": {
          "$ref": "#/$defs/support_type_enum"
        },
        "gap_rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "vendor_help_ref": {
      "type": "object",
      "required": [
        "vendor",
        "product",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "path_hint": {
          "type": "string"
        }
      }
    },
    "evidence_artifact": {
      "type": "object",
      "required": [
        "artifact_id",
        "artifact_type",
        "description",
        "collector",
        "retention_days",
        "storage_location_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_type": {
          "$ref": "#/$defs/artifact_type_enum"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "collector": {
          "type": "string",
          "minLength": 1
        },
        "retention_days": {
          "type": "integer",
          "minimum": 0
        },
        "storage_location_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
