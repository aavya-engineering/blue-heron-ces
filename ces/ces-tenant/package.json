{
  "name": "ces-tenant",
  "version": "0.5.0",
  "description": "TenantManager — tenant connection registry, auth-strategy, and session/HTTP client surfaces shared across CES modules",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ces-tenant": "dist/service/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "serve": "npm run build && node dist/service/cli.js serve"
  },
  "license": "PROPRIETARY",
  "devDependencies": {
    "@types/node": "^20.10.5",
    "typescript": "^5.3.3",
    "vitest": "^4.1.7"
  }
}
