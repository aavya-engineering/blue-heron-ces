      },
      {
        "objectType": "csExternalAccessPolicy"
      },
      {
        "objectType": "atpPolicyForO365"
      },
      {
        "objectType": "adminAuditLogConfig"
      },
      {
        "objectType": "transportConfig"
      },
      {
        "objectType": "authenticationMethodsPolicyConfigurations"
      },
      {
        "objectType": "caPolicies",
        "objectId": "CMMC-MFA-CompliantDevice"
      }
    ]
  },
  "ao_coverage": {
    "enabled": true,
    "expected_total": 96
  },
