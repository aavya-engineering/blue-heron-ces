{
  "scenario_id": "exo-protection-baseline",
  "description": "Exchange-engine session-type coverage: ATP for SPO/Teams/ODB enabled and legacy TLS clients disallowed - both are exchange-session set_commands whose post-state the sim persists (named-cmdlet arg-state fidelity, ces-stacksim 13e7a14).",
  "target_level": "L2",
  "lanes": ["sim"],
  "stacksim_seed": {
    "stance": "m365_azure",
    "countOverrides": {},
    "steps": []
  },
  "muster": {
    "answer_map": {
      "G-01": { "wizard": "sit", "answer_type": "enum", "value": "L2" },
      "G-02": { "wizard": "sit", "answer_type": "enum", "value": "cui_present" },
      "G-07": { "wizard": "sit", "answer_type": "enum", "value": "single_enclave" },
      "TCP.LIC.001": { "wizard": "tcp", "answer_type": "single_select", "value": "Microsoft 365 G5" }
    },
    "mid_pipeline_assertions": [
      {
        "path": "outputs.human_readable_mission_plan.control_directives[?(@.control_id=='IR.L2-3.6.1')]",
        "assert": "exists",
        "array_path": "outputs.human_readable_mission_plan.control_directives",
        "match_field": "control_id",
        "match_value": "IR.L2-3.6.1"
      }
    ]
  },
  "stamper": { "execution_mode": "auto" },
  "fault_injection": [],
  "expected_state": {
    "checks": [
      {
        "description": "ATP enabled for SPO/Teams/ODB (Set-AtpPolicyForO365 -EnableATPForSPOTeamsODB $true)",
        "request": { "kind": "cmdlet", "cmdlet": "Get-AtpPolicyForO365" },
        "path": "EnableATPForSPOTeamsODB",
        "assert": "equals",
        "value": true,
        "ledger_object_type": "atpPolicyForO365"
      },
      {
        "description": "Legacy TLS clients disallowed (Set-TransportConfig -AllowLegacyTLSClients $false)",
        "request": { "kind": "cmdlet", "cmdlet": "Get-TransportConfig" },
        "path": "AllowLegacyTLSClients",
        "assert": "equals",
        "value": false,
        "ledger_object_type": "transportConfig"
      }
    ]
  },
  "expected_evidence": []
}