# syntax=docker/dockerfile:1
FROM node:20-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy mono workspace package manifests
COPY ces-mono-main/package*.json ./
COPY ces-mono-main/ces-shared/package*.json ./ces-shared/
COPY ces-mono-main/ces-planner/package*.json ./ces-planner/
COPY ces-tenant-main/package*.json ./ces-tenant/

# Install dependencies
RUN npm ci

# Copy source trees
COPY ces-mono-main/scripts ./scripts/
COPY ces-mono-main/ces-shared ./ces-shared/
COPY ces-mono-main/ces-planner ./ces-planner/
COPY ces-tenant-main ./ces-tenant/

# Build required packages and sync assets
RUN (cd ./ces-tenant && npm run build) && npm run build:shared && node scripts/sync-ui-assets.mjs

ENV NODE_ENV=development
ENV PORT=5001
ENV CES_PIPELINE_ROOT=/app/pipeline

EXPOSE 5001

CMD ["npm", "run", "dev", "-w", "ces-planner", "--", "--host", "0.0.0.0", "--port", "5001"]
