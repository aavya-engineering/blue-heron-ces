  "toolchain": [
    {
      "name": "node",
      "version": "24.12.0",
      "why": "Node.js in use on the BHD build machine; all packages build and test with it. The pin file is .nvmrc at the ces-mono root.",
      "check": "node --version"
    },
    {
      "name": "npm",
      "version": "11.6.2",
      "why": "npm in use on the BHD build machine (bundled with Node 24.12.0); the lockfiles were written by it.",
      "check": "npm --version"
    },
    {
      "name": "git",
      "version": ">=2.52.0",
      "why": "Clones the five repos and checks out the manifest commits. This is the version on the BHD build machine; older 2.x releases are untested.",
      "check": "git --version"
    },
    {
      "name": "windows-powershell",
      "version": "5.1",
      "why": "Stamper, AO and the tenant session factory start powershell.exe to run tenant commands; the run scripts (bootstrap, identity scan) target Windows PowerShell 5.1.",
      "check": "powershell.exe -NoProfile -Command \"(Get-Host).Version.ToString()\""
    },
    {
      "name": "Microsoft.Graph.Authentication",
      "version": "2.35.1",
      "why": "PowerShell module pinned by ces-tenant for live Graph sessions (Import-Module -RequiredVersion). Live tenants only; the simulator does not need it. The pin list is ces-tenant/src/data/module-pins.json.",
      "check": "powershell.exe -NoProfile -Command \"(Get-Module -ListAvailable Microsoft.Graph.Authentication).Version -join ', '\""
    }
  ],
