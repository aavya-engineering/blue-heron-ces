# CES settings reference. Generated by scripts/handoff/gen.mjs from config.schema.yaml; do not edit.
# Reference only: do not copy this file to .env. Set a setting with $env:NAME = 'value' in the PowerShell window
# that starts a server, or in the service definition (GUIDE section 5). Only Stamper reads a .env file, from its
# working folder, and there an empty NAME= sets the setting to an empty string instead of leaving it unset.
# Optional settings are commented out; "# Default:" says what happens when one is not set.
# Secrets appear as NAME= with no value: create each one as secrets.inventory.yaml describes.
# Never commit or share a copy with values filled in.

# ===== (no component) =====

# Default tenant slug for the end-user tenant test suite runner (tenant-tests/run.ps1), used when -TenantSlug is not passed; never part of npm test.
# owner operator; scope live; optional
# Default: unset = run.ps1 prints usage and exits 0
# Allowed: tenant slug
# CES_EUT_TENANT=

# Overrides the folder the end-user tenant test suite's TenantProbe.psm1 reads Stamper tenant configs from; the unit gate (run-tests.mjs) and the stacksim TenantProbe test point it at a temp folder so a test never writes the real ~\.stamper\tenants (PL-123, clean-room CR-17).
# owner contractor; scope dev; optional
# Default: %USERPROFILE%\.stamper\tenants
# Allowed: a folder path holding <slug>.json tenant configs
# CES_STAMPER_TENANTS_DIR=

# ===== ces-ao =====

# When exactly '1', makes AO's CUI-boundary parameter check strict (denies the ambiguous 'case-a' boundary values); AO's CMMC scope gate is already strict by default, so '1' only confirms it there.
# owner operator; scope all; optional
# Default: unset = off for the CUI-boundary parameter check; the CMMC scope gate is strict regardless (CMMC_STRICT_DEFAULT = true)
# Allowed: '1' = strict; anything else = not strict (cannot turn the scope gate's built-in strict default off)
# AO_CMMC_STRICT=

# When exactly 'all', AO's request logger logs every HTTP request instead of the quiet default; read once at start, so a change needs a restart.
# owner operator; scope all; optional
# Default: unset = quiet request logging
# Allowed: 'all' = log every request; anything else = quiet
# AO_LOG_REQUESTS=

# When exactly '1', lets the AO MCP server (ces-adminops-mcp) run AdminOps commands for real (dryRun:false); otherwise every MCP execute is a dry-run preview.
# owner operator; scope all; optional
# Default: unset = MCP calls are dry-run only
# Allowed: '1' = live writes allowed; anything else = dry-run only
# AO_MCP_ALLOW_APPLY=

# When exactly '1' (and CES_AO_SIM_ONLY is not '1'), lets AO run commands against a tenant record explicitly marked kind 'live'; otherwise AO refuses every non-sim tenant, dry-runs included.
# owner operator; scope live; optional
# Default: unset = live (non-sim) tenants refused
# Allowed: '1' = opt in to live; anything else = sim only
# CES_AO_ALLOW_LIVE=

# Bearer token every AO /api/* call must carry once set (health stays open); unset means loopback requests pass without a token and network requests get 401; read through secretEnv(): a DPAPI store value wins over the environment.
# owner contractor; scope all; optional
# Secret: see secrets.inventory.yaml (CES_AO_AUTH_TOKEN). Never write the value here.
CES_AO_AUTH_TOKEN=

# Address AO's server listens on; unset or 'all' listens on every interface (tokens gate access), any other value binds that one address.
# owner operator; scope all; optional
# Default: 'all' (every interface)
# Allowed: 'all' or one listen address (IP or hostname)
# CES_AO_BIND=

# Tenant ID attached to AO's loopback dev principal (set by CES_AO_DEV_PRINCIPAL_UPN), so it may decide approvals for that tenant only; without it the dev principal is refused (fail closed).
# owner contractor; scope dev; optional
# Default: unset = the dev principal can decide no approvals
# Allowed: a tenant ID (GUID)
# CES_AO_DEV_PRINCIPAL_TENANT=

# When set, AO accepts an unverified local dev principal with this UPN and the approver role (marked 'dev-unverified'), for development without signed principal tokens.
# owner contractor; scope dev; optional
# Default: unset = no dev principal
# Allowed: a user principal name (email form)
# CES_AO_DEV_PRINCIPAL_UPN=

# Tenants the leaver-flow timer scans for leavers and advances (reminders, escalations) every CES_AO_LEAVER_TICK_MIN minutes; the timer runs only when both settings are set. A scan reads the tenant.
# owner operator; scope all; optional
# Default: unset = no leaver timer
# Allowed: comma-separated tenant slugs
# CES_AO_LEAVER_TENANTS=

# Interval of the optional leaver-flow timer (scan + tick for each tenant in CES_AO_LEAVER_TENANTS); without it, scans and ticks run only through POST /api/leaver/scan and /api/leaver/tick.
# owner operator; scope all; optional
# Default: unset = off (no timer, no scan)
# Allowed: a positive number of minutes
# CES_AO_LEAVER_TICK_MIN=

# Port used only to build the default CES_AO_PUBLIC_URL for leaver confirm links; it does not choose the port AO listens on (that is the --port flag).
# owner operator; scope all; optional
# Default: the port AO listens on (AO fills it in at start); 3001 if neither is known
# Allowed: a TCP port number
# CES_AO_PORT=

# Optional 'aud' claim EO writes into AO approver tokens and that AO and EO then require when verifying them.
# owner operator; scope all; optional; read by ces-ao, ces-eo
# Default: unset = audience not set or checked
# Allowed: any string
# CES_AO_PRINCIPAL_AUDIENCE=

# Optional 'iss' claim EO writes into AO approver tokens and that AO and EO then require when verifying them.
# owner operator; scope all; optional; read by ces-ao, ces-eo
# Default: unset = issuer not set or checked
# Allowed: any string
# CES_AO_PRINCIPAL_ISSUER=

# HS256 signing secret shared by EO (mints AO approver tokens) and AO (verifies the x-ces-principal token on approvals); read through secretEnv(): a DPAPI store value wins over the environment.
# owner contractor; scope all; optional; read by ces-ao, ces-eo
# Secret: see secrets.inventory.yaml (CES_AO_PRINCIPAL_SECRET). Never write the value here.
CES_AO_PRINCIPAL_SECRET=

# The approving person's own signed principal token, read by the 'ao approve' CLI (keeps it out of shell history); the approver recorded is the token's UPN and self-approval is refused.
# owner operator; scope all; optional
# Secret: see secrets.inventory.yaml (CES_AO_PRINCIPAL_TOKEN). Never write the value here.
CES_AO_PRINCIPAL_TOKEN=

# Internal: set by AO itself in the environment of its certificate-probe PowerShell child to name the store to search for the tenant certificate; not an operator setting.
# owner contractor; scope all; optional
# Default: Cert:\CurrentUser\My then Cert:\LocalMachine\My
# Allowed: a PowerShell certificate store path
# CES_AO_PROBE_STORE=

# Internal: set by AO itself in the environment of its certificate-probe PowerShell child to pass the thumbprint being looked up; not an operator setting.
# owner contractor; scope all; optional
# Default: set by AO per probe
# Allowed: a certificate thumbprint
# CES_AO_PROBE_THUMB=

# Base of the single-use confirm links that the leaver flow puts in each confirmation request to a tenant administrator (route /api/leaver/confirm/<flowId>); set it to AO's address as administrators see it.
# owner operator; scope all; optional
# Default: http://localhost:<CES_AO_PORT>
# Allowed: an http(s) base URL that tenant administrators can reach
# CES_AO_PUBLIC_URL=

# When exactly '1', AO refuses every non-sim tenant even if CES_AO_ALLOW_LIVE=1 (lockdown beats opt-in); the harness sets it on every AO it starts.
# owner contractor; scope sim; optional
# Default: unset = no lockdown (live still needs CES_AO_ALLOW_LIVE=1)
# Allowed: '1' = lockdown; anything else = no lockdown
# CES_AO_SIM_ONLY=

# BHD role mailbox that receives a leaver-flow done notice, only for tenants whose leaver setting notifyBhdOnDone is on (customer opt-in, default off, set through PUT /api/leaver/settings); messages go to AO's simulated outbox and are not sent by CES.
# owner BHD; scope all; optional
# Default: unset = an opted-in done notice is recorded as undeliverable
# Allowed: one mailbox address (a BHD role mailbox, never a person)
# CES_BHD_NOTICE_MAILBOX=

# Overrides the location of the price file AO's cost gate reads to show the recurring cost of an operation.
# owner operator; scope all; optional
# Allowed: a file path
# CES_COST_ESTIMATES_PATH=ces-shared/src/data/cost-estimates.reference.json

# When exactly '1', the AO and Stamper GUI servers do not open a browser window on start.
# owner contractor; scope all; optional; read by ces-ao, ces-stamper
# Default: browser opens
# Allowed: '1' = do not open a browser; anything else = open
# CES_NO_OPEN=

# Re-enables two-person approval (the Tier 3 second approver, the live-L2 floor and the approver-token requirement in AO), which is off by default; read at call time so it can be toggled.
# owner operator; scope all; optional; read by ces-ao, ces-eo
# Default: unset = off
# Allowed: AO: '1' or 'true' (any case, trimmed) = on; EO UI flag: exactly '1' = on; anything else = off
# CES_TWO_PERSON_APPROVAL=

# When exactly 'development', the AO execute route includes the error stack in its 500 response body.
# owner contractor; scope dev; optional
# Default: unset
# Allowed: 'development' = include stack traces; anything else = omit
# NODE_ENV=

# URL of the tenant-stacksim server; when set, modules run PowerShell against the simulator (AO also requires a loopback URL and the shim module first on PSModulePath before it treats the process as sim mode).
# owner contractor; scope sim; optional; read by ces-ao, ces-eo, ces-stamper, ces-tenant, ces-tester, muster-api, tenant-stacksim
# Default: http://127.0.0.1:4390 (ces-tenant and az shim); unset elsewhere = simulator off
# Allowed: simulator server URL; AO's sim rail accepts only localhost/127.0.0.1 URLs
# STACKSIM_SERVER_URL=

# ===== ces-ao-ui =====

# Output folder for the AO console's Playwright end-to-end run (reports, traces, video).
# owner contractor; scope dev; optional
# Allowed: a directory path
# CES_AO_E2E_OUT=C:/ces-nb/out/ui/ao/playwright

# Port the AO console's Playwright end-to-end run starts its own AO server on (kept off the simulator's 4390).
# owner contractor; scope dev; optional
# Allowed: a TCP port number
# CES_AO_E2E_PORT=5103

# Root folder for all CES runtime data (ces.db, each module's storage, Stamper plan-data, tenant registry, evidence catalog copy, EO validation reports).
# owner operator; scope all; optional; read by ces-ao-ui, ces-ec, ces-eo, ces-shared, ces-tenant, ces-tester
# Default: %LOCALAPPDATA%\CES\pipeline on Windows; <cwd>/<posix default> elsewhere
# Allowed: directory path
# CES_PIPELINE_ROOT=

# Overrides the root folder of the ces-tenant registry (sim and live tenant records kept in separate subfolders); EO resolves tenants through the same root, and the harness points it at a run-scoped folder so ephemeral sim tenants stay isolated.
# owner contractor; scope all; optional; read by ces-ao-ui, ces-eo, ces-tenant, ces-tester
# Default: %USERPROFILE%\.ces\tenants
# Allowed: a folder path; records live at <root>\sim\<slug>.json and <root>\live\<slug>.json
# CES_TENANT_ROOT=

# Makes the AO and EO UI Playwright end-to-end runs headless; by default they run headed, paced and captioned so they can be watched.
# owner contractor; scope dev; optional; read by ces-ao-ui, ces-eo-ui
# Default: unset = headed (watched) run
# Allowed: exactly '1' = headless; anything else = headed
# CES_UI_HEADLESS=

# ===== ces-ec =====

# Optional 'aud' claim EO writes into EC uploader tokens and that EC then requires when verifying them.
# owner operator; scope all; optional; read by ces-ec, ces-eo
# Default: unset = audience not set or checked
# Allowed: any string
# CES_EC_PRINCIPAL_AUDIENCE=

# Optional 'iss' claim EO writes into EC uploader tokens and that EC then requires when verifying them.
# owner operator; scope all; optional; read by ces-ec, ces-eo
# Default: unset = issuer not set or checked
# Allowed: any string
# CES_EC_PRINCIPAL_ISSUER=

# HS256 signing secret shared by EO (mints uploader tokens) and EC (verifies the uploader's x-ces-principal token); read through secretEnv(): a DPAPI store value wins over the environment.
# owner contractor; scope all; optional; read by ces-ec, ces-eo
# Secret: see secrets.inventory.yaml (CES_EC_PRINCIPAL_SECRET). Never write the value here.
CES_EC_PRINCIPAL_SECRET=

# EC's sim-only rail: on unless exactly '0', it refuses ingest for any tenant not marked kind 'sim' (fail closed); '0' also admits tenants marked kind 'live'.
# owner operator; scope all; optional
# Default: on (sim only)
# Allowed: '0' = live tenants allowed; any other value or unset = sim only
# CES_EC_SIM_ONLY=

# Explicit path to the evidence catalog JSON that EC and EO load; when set it is the only candidate, otherwise the pipeline-root copy then the ces-muster source copy are tried.
# owner contractor; scope all; optional; read by ces-ec, ces-eo
# Default: <CES_PIPELINE_ROOT>\evidence-catalog\evidence-catalog-release-0.json, else the copy in ces-muster/src/features/plan/engine/data/evidence-catalog
# Allowed: file path
# CES_EVIDENCE_CATALOG_PATH=

# Address the Evidence Collector (EC) server listens on; unset or 'all' listens on every interface (the bearer token gates network callers), any other value binds that one address.
# owner operator; scope all; optional
# Default: 'all' (every interface)
# Allowed: 'all' or one listen address (IP or hostname)
# EC_HOST=

# Minutes between EC's scheduled evidence index passes (one pass also runs at start-up).
# owner operator; scope all; optional
# Allowed: a positive number of minutes; invalid or non-positive falls back to 15
# EC_INDEX_INTERVAL_MIN=15

# TCP port the Evidence Collector (EC) server listens on.
# owner operator; scope all; optional
# Allowed: a positive integer below 65536; otherwise 4001
# EC_PORT=4001

# Age in days after which EC's index pass flags an evidence item as stale.
# owner operator; scope all; optional
# Allowed: a positive number of days; invalid falls back to 90
# EC_STALE_DAYS=90

# Bearer secret for EC's authenticated routes (ingest, index, items) and the one EO attaches when it calls EC; read through secretEnv(), so a DPAPI store value wins over the environment, and when unset EC disables those routes and EO refuses EC reads/writes.
# owner contractor; scope all; required; read by ces-ec, ces-eo
# Secret: see secrets.inventory.yaml (EVIDENCE_OPS_SECRET). Never write the value here.
EVIDENCE_OPS_SECRET=

# ===== ces-eo =====

# Picks the tenant EO starts on; when set, EO refuses to start unless that slug is in the tenant registry, and it is used only if TENANT_SLUG and the tenant config give no slug.
# owner operator; scope all; optional
# Default: unset = EO uses TENANT_SLUG, the tenant config, or the last-used tenant
# Allowed: a tenant slug registered in the ces-tenant registry
# ACTIVE_TENANT_SLUG=

# Simulator run window: EO's AdminOps evidence reader skips every AdminOps row timed before this ISO time; a real deployment leaves it unset (six-year retention).
# owner contractor; scope sim; optional
# Default: unset = EO reads the whole AdminOps history
# Allowed: an ISO 8601 time
# CES_EO_ADMINOPS_SINCE=

# Approver token the 'eo' CLI review command sends to prove the reviewer when --approver-token is not given.
# owner operator; scope all; optional
# Secret: see secrets.inventory.yaml (CES_EO_APPROVER_TOKEN). Never write the value here.
CES_EO_APPROVER_TOKEN=

# Bearer token for EO's /api/* routes: EO requires it once set, and the eo CLI, muster-api (with CES_EO_URL) and the tester send it; read through secretEnv() on EO: a DPAPI store value wins over the environment.
# owner contractor; scope all; optional; read by ces-eo, ces-tester, muster-api
# Secret: see secrets.inventory.yaml (CES_EO_AUTH_TOKEN). Never write the value here.
CES_EO_AUTH_TOKEN=

# Address EO listens on (unset = every interface, tokens gate access); EO also uses it to pick the address its scheduler calls itself on (127.0.0.1 when unset or a wildcard).
# owner operator; scope all; optional
# Default: unset = every interface
# Allowed: one listen address (IP or hostname); '0.0.0.0' or '::' = all
# CES_EO_BIND=

# Delay in seconds before EO's collection scheduler first ticks; proof rounds set a short value to see a tick.
# owner operator; scope all; optional
# Default: the assess interval (SIGNAL_CAPTURE_INTERVAL_HOURS, 24 h)
# Allowed: a number of seconds >= 0
# CES_EO_COLLECT_FIRST_TICK_SEC=

# When exactly '1', EO's scheduler collects from every registered live tenant; otherwise it collects sim tenants, live tenants on the allowlist, and tenants with a connected operator session.
# owner operator; scope live; optional
# Default: unset = only live tenants named in CES_EO_COLLECT_TENANTS (plus connected operator sessions)
# Allowed: '1' = collect every live tenant; anything else = allowlist only
# CES_EO_COLLECT_LIVE=

# Comma-separated allowlist of tenant slugs EO's collection scheduler may collect from.
# owner operator; scope all; optional
# Default: unset = all registered tenants (live ones still gated by CES_EO_COLLECT_LIVE)
# Allowed: comma-separated tenant slugs
# CES_EO_COLLECT_TENANTS=

# Minutes between EO collection-scheduler ticks after the first.
# owner operator; scope all; optional
# Allowed: a number of minutes >= 0 (floor 1 second)
# CES_EO_COLLECT_TICK_MIN=15

# Optional 'aud' claim EO requires on dev HS256 operator tokens (those signed with CES_EO_OPERATOR_SECRET under CES_EO_OPERATOR_DEV_FALLBACK=1).
# owner contractor; scope dev; optional
# Default: unset = audience not checked
# Allowed: any string
# CES_EO_OPERATOR_AUDIENCE=

# When exactly '1' and neither Entra nor passkey operator sign-in is configured, EO accepts loopback operator tokens signed with CES_EO_OPERATOR_SECRET (marked dev-unverified); set together with Entra or passkeys it is refused (503).
# owner contractor; scope dev; optional
# Default: unset = off
# Allowed: '1' = on; anything else = off
# CES_EO_OPERATOR_DEV_FALLBACK=

# Audience EO expects in an Entra operator sign-in token; only used when Entra operator sign-in is configured.
# owner operator; scope live; optional
# Default: the value of CES_EO_OPERATOR_ENTRA_CLIENT_ID
# Allowed: token audience string (usually the app client id or api://<client id>)
# CES_EO_OPERATOR_ENTRA_AUDIENCE=

# Entra sign-in host EO uses to build the token issuer and the JWKS (signing-key) URL for Entra operator sign-in.
# owner operator; scope live; optional
# Allowed: bare host name matching /^[a-z0-9.-]+$/i (e.g. login.microsoftonline.us for GCC High); anything else refuses Entra sign-in
# CES_EO_OPERATOR_ENTRA_AUTHORITY_HOST=login.microsoftonline.com

# Client id of the customer Entra app registration that EO accepts operator sign-in tokens for; setting any of the three Entra keys turns Entra operator sign-in on and the rest become mandatory.
# owner operator; scope live; optional
# Default: unset = Entra operator sign-in off
# Allowed: GUID (app registration client id); required together with CES_EO_OPERATOR_ENTRA_TENANT_ID and CES_EO_OPERATOR_ENTRA_GROUP_ID
# CES_EO_OPERATOR_ENTRA_CLIENT_ID=

# Object id of the Entra group whose members EO treats as BHD operators allowed to mint approver tokens under Entra sign-in.
# owner operator; scope live; optional
# Default: unset = Entra operator sign-in off
# Allowed: GUID (Entra group object id); required together with the tenant and client id
# CES_EO_OPERATOR_ENTRA_GROUP_ID=

# Overrides the issuer EO requires in Entra operator sign-in tokens.
# owner operator; scope live; optional
# Default: https://<authority host>/<tenant id>/v2.0
# Allowed: issuer URL string
# CES_EO_OPERATOR_ENTRA_ISSUER=

# Entra tenant whose sign-in tokens EO accepts for operators (the customer's tenant on live installs, per the customer-issued-account rule).
# owner operator; scope live; optional
# Default: unset = Entra operator sign-in off
# Allowed: GUID (operator's Entra tenant id); required together with the client id and group id
# CES_EO_OPERATOR_ENTRA_TENANT_ID=

# Optional issuer claim required on dev-fallback HS256 operator tokens (only used when CES_EO_OPERATOR_DEV_FALLBACK=1 and no Entra or passkey config).
# owner contractor; scope sim; optional
# Default: unset = issuer not checked
# Allowed: string
# CES_EO_OPERATOR_ISSUER=

# Web origin of the EO console that passkey (WebAuthn) operator sign-in is bound to; setting either passkey key turns passkey sign-in on, and it cannot be combined with Entra sign-in or the dev fallback.
# owner operator; scope all; optional
# Default: unset = passkey operator sign-in off
# Allowed: URL with https:, or http://localhost; required when CES_EO_OPERATOR_PASSKEY_RP_ID is set
# CES_EO_OPERATOR_PASSKEY_ORIGIN=

# Passkey relying-party id (the domain the passkeys are registered to) for EO operator sign-in.
# owner operator; scope all; optional
# Default: host name of CES_EO_OPERATOR_PASSKEY_ORIGIN
# Allowed: host name equal to the origin's host or a parent domain of it; never an IP address
# CES_EO_OPERATOR_PASSKEY_RP_ID=

# HS256 shared secret EO uses to verify dev-only operator tokens when CES_EO_OPERATOR_DEV_FALLBACK=1 (principals are marked dev-unverified); read through secretEnv(): a DPAPI store value wins over the environment.
# owner contractor; scope sim; optional
# Secret: see secrets.inventory.yaml (CES_EO_OPERATOR_SECRET). Never write the value here.
CES_EO_OPERATOR_SECRET=

# Lifetime in seconds of an EO operator session created by passkey sign-in.
# owner operator; scope all; optional
# Allowed: whole number 1 to 900; anything else refuses passkey sign-in config
# CES_EO_OPERATOR_SESSION_TTL_SECONDS=900

# Optional tenant pin on EO's bearer auth: when set, a request naming a different tenant (query tenant or body tenantSlug) is refused 403.
# owner operator; scope all; optional
# Default: unset = no tenant pin
# Allowed: tenant slug
# CES_EO_TENANT=

# Base URL of the EvidenceOps server, used by the eo CLI and by muster-api to push plan intake and interview records to EO (muster-api skips the push unless both this and CES_EO_AUTH_TOKEN are set).
# owner contractor; scope all; optional; read by ces-eo, muster-api
# Default: EO CLI: http://127.0.0.1:4002; muster-api: unset = no push to EO
# Allowed: http(s) base URL of the EO server
# CES_EO_URL=

# Folder where EO's document renderers write generated policies, POA&M, reports and the risk-assessment store.
# owner operator; scope all; optional
# Allowed: a folder path (resolved against the EO working directory)
# COMPLIANCE_REPO_PATH=./compliance-repo

# Makes EO's SSP generator log, per control, which narrative source it used (template engine, snippet resolver, mission plan or fallback).
# owner contractor; scope dev; optional
# Default: unset = off
# Allowed: exactly 'true' = on; anything else = off
# DEBUG_NARRATIVES=

# Base URL EO uses to reach the standalone Evidence Collector service.
# owner operator; scope all; optional
# Allowed: an http(s) base URL
# EC_URL=http://127.0.0.1:4001

# Turns EO's scheduled compliance-signal capture on or off; it is on (daily) unless set to an off word.
# owner operator; scope all; optional
# Default: on
# Allowed: 0, false, no or off (any case) = off; anything else = on
# ENABLE_SCHEDULED_SIGNAL_CAPTURE=

# Oldest an SSP, POA&M or assessment snapshot may be, in hours, when EO builds an evidence package.
# owner operator; scope all; optional
# Allowed: a positive number of hours; otherwise 24
# EO_PACKAGE_MAX_AGE_HOURS=24

# TCP port the EO server listens on; the root npm script and the harness set it (5004 and per-run ports).
# owner operator; scope all; optional
# Allowed: a number (coerced)
# EO_PORT=4002

# Folder where EO's SSP quality scorecard writes its pre-export validation reports.
# owner operator; scope all; optional
# Default: <CES_PIPELINE_ROOT>\EvidenceOps\validation, else <cwd>\output\validation
# Allowed: a folder path
# EO_VALIDATION_REPORT_DIR=

# UNCLEAR: EO parses this comma list into config.graphScopes (default the GCC High .default scope), but no code outside EoConfig.ts reads graphScopes.
# owner operator; scope live; optional
# Allowed: comma-separated OAuth scopes
# GRAPH_SCOPES=https://graph.microsoft.us/.default

# Infrastructure manifest EO loads; when unset EO auto-discovers the newest one in the tenant's Stamper plan-data folder.
# owner operator; scope all; optional
# Default: newest <plan-data>\<slug>\plans\infrastructure-manifest-*.json
# Allowed: a file path
# INFRA_MANIFEST_PATH=

# Optional infrastructure registry that EO loads alongside the main registry for assessment, POA&M, documents and config views.
# owner operator; scope all; optional
# Default: unset = no infrastructure registry
# Allowed: a file path
# INFRA_REGISTRY_PATH=

# Mission plan EO loads; when unset EO auto-discovers the newest one in the tenant's Stamper plan-data folder.
# owner operator; scope all; optional
# Default: newest <plan-data>\<slug>\plans\manual-mission-plan-*.json
# Allowed: a file path
# MISSION_PLAN_PATH=

# Path of the Stamper command registry EO maps controls from (EO also derives the Stamper root two folders above it); EO config validation fails at start without it.
# owner contractor; scope all; required
# Allowed: path to a Stamper command registry JSON, e.g. ces-stamper/src/registry/cmmc-l2-commands.registry.json
REGISTRY_PATH=

# Interval in hours of EO's scheduled compliance-signal capture.
# owner operator; scope all; optional
# Allowed: number of hours
# SIGNAL_CAPTURE_INTERVAL_HOURS=24

# Root of Stamper's plan-data that EO searches per tenant slug for manifests, the mission plan and variables.json.
# owner contractor; scope all; optional
# Default: {CES_PIPELINE_ROOT}\Stamper\plan-data
# Allowed: directory path
# STAMPER_PLAN_DATA_ROOT=

# Module storage root: EO keeps its evidence store and last-tenant file under it, and Stamper derives its state, evidence and logs folders from it.
# owner contractor; scope all; optional; read by ces-eo, ces-stamper
# Default: {CES_PIPELINE_ROOT}\<Module>\storage (EvidenceOps for EO, Stamper for Stamper)
# Allowed: directory path
# STORAGE_ROOT=

# Path to a tenant config JSON that EO loads at start; its slug is used when TENANT_SLUG is not set.
# owner operator; scope all; optional
# Default: unset = resolve through the ces-tenant registry by slug
# Allowed: path to a tenant config JSON
# TENANT_CONFIG=

# Explicit tenant-manifest file for EO; unset, EO auto-discovers the newest pushed manifest for the tenant slug.
# owner contractor; scope all; optional
# Default: newest tenant-manifest-<slug>-*.json found under Stamper plan-data
# Allowed: file path
# TENANT_MANIFEST_PATH=

# Tenant slug EO starts on, and the last fallback Stamper uses for the tenant slug when publishing execution results.
# owner operator; scope all; optional; read by ces-eo, ces-stamper
# Default: EO: tenant config slug, then ACTIVE_TENANT_SLUG, then last-used tenant; Stamper dotenv: 'unknown'
# Allowed: tenant slug
# TENANT_SLUG=

# ===== ces-eo-ui =====

# Output folder for the EO UI Playwright run's videos, traces and reports.
# owner contractor; scope dev; optional
# Allowed: a folder path
# CES_UI_OUTPUT_DIR=C:/ces-nb/out/ui/eo/playwright

# Pacing delay in milliseconds between actions in the EO UI Playwright run.
# owner contractor; scope dev; optional
# Default: 400 (ms) when headed, 0 when headless
# Allowed: a number of milliseconds; non-numeric falls back to the default
# CES_UI_SLOWMO=

# EO server URL that the EO UI Playwright end-to-end run drives.
# owner contractor; scope dev; optional
# Allowed: an http(s) base URL
# EO_URL=http://127.0.0.1:5004

# ===== ces-muster =====

# Path to the organisation's interview answers that the plan-from-discovery script (and the discovery CLI when --answers is absent) uses in place of the scripted boundary decision; muster-api and the tester set it for the child run.
# owner contractor; scope sim; optional; read by ces-muster, muster-api
# Default: unset = scripted simulator boundary decision
# Allowed: path to an interview-answers JSON file (InterviewFact[])
# MX_ANSWERS=

# Path of the discovery document the plan-from-discovery script compiles a plan from; the script stops if it is unset, and muster-api's plan-compile service sets it for the child run.
# owner contractor; scope sim; required
# Allowed: path to a discovery JSON file
MX_DISCOVERY=

# Initial-password reference muster-api issued, which the plan-from-discovery script writes into the plan in place of its generated answer (a reference, never the password).
# owner contractor; scope sim; optional
# Default: unset = the script's own generated simulator initial-password fact
# Allowed: a secret reference of the form secretref:one-time:<uuid>
# MX_INITIAL_PASSWORD_REF=

# Path to the organisation content JSON that the plan-from-discovery script reads into the plan (including its simulation block).
# owner contractor; scope sim; optional
# Default: unset = no organisation content
# Allowed: path to an org-content JSON file
# MX_ORG_CONTENT=

# Output directory where the plan-from-discovery script writes the compiled plan; the script stops if it is unset.
# owner contractor; scope sim; required
# Allowed: output directory path
MX_OUT=

# Tenant slug the plan-from-discovery script compiles the plan for; the script stops if it is unset.
# owner contractor; scope sim; required
# Allowed: tenant slug
MX_SLUG=

# Comma-separated technology stacks the plan-from-discovery script plans for.
# owner contractor; scope sim; optional
# Allowed: comma-separated stack ids
# MX_STACKS=m365_e5_gcc,microsoft_intune,microsoft_sentinel

# When exactly 'off', the plan-from-discovery script skips the readiness and tenant-fact harvest against the simulator's Graph endpoint.
# owner contractor; scope sim; optional
# Default: unset = harvest on
# Allowed: 'off' (exact) = skip the simulator harvest; anything else = harvest
# MX_TENANT_HARVEST=

# Build-time setting (Vite inlines it at build) for the muster-api base URL the Muster SPA calls when no runtime __MUSTER_CONFIG__.apiBaseUrl is present.
# owner contractor; scope all; optional
# Allowed: muster-api base URL
# VITE_MUSTER_API_URL=/api

# ===== ces-shared =====

# Path to the operator's recorded acknowledgment that lets a release build start even though the at-rest encryption check (Azure encryption at host or BitLocker) cannot show the data volumes are encrypted.
# owner operator; scope live; optional
# Default: unset = no override record
# Allowed: a file path to a 'ces-at-rest-override' JSON record
# CES_AT_REST_OVERRIDE_FILE=

# Explicit path to the CES config file (customer bindings); an absent file means an empty config, a malformed one throws.
# owner operator; scope all; optional
# Default: {CES_PIPELINE_ROOT}\ces.config.json
# Allowed: a file path
# CES_CONFIG_PATH=

# When exactly '1', the shared EC launcher (used by Stamper at start) spawns the Evidence Collector if its health check fails; otherwise it only reports EC as down.
# owner operator; scope all; optional; read by ces-shared, ces-stamper
# Default: unset = never start EC automatically
# Allowed: '1' = auto-start; anything else = off
# CES_EC_AUTOSTART=

# Working directory the shared EC launcher starts the Evidence Collector from when it auto-starts it.
# owner contractor; scope all; optional
# Default: <caller's working directory>/../ces-ec
# Allowed: a directory path
# CES_EC_CWD=

# Location of the DPAPI-protected module-secret store that every CES server loads at start (written by ces-shared/scripts/New-CesModuleSecrets.ps1).
# owner operator; scope all; optional
# Default: %ProgramData%\CES\secrets\module-secrets.dpapi
# Allowed: file path
# CES_MODULE_SECRETS_PATH=

# When exactly '1', a server refuses to start if the module-secret store file is missing instead of falling back to environment variables.
# owner operator; scope all; optional
# Default: off (missing store = environment only)
# Allowed: '1' = refuse to start when the store is missing; anything else = allow
# CES_MODULE_SECRETS_REQUIRED=

# Carries the PFX import password from the Stamper certificate-import request into the PowerShell child's environment only (never its command line); set by CES itself and removed in the child before import.
# owner contractor; scope all; optional
# Secret: see secrets.inventory.yaml (CES_PFX_PASSWORD). Never write the value here.
CES_PFX_PASSWORD=

# Carries the .pfx file path into the PowerShell child that imports the tenant certificate into Cert:\CurrentUser\My; set by CES itself.
# owner contractor; scope all; optional
# Allowed: set internally
# CES_PFX_PATH=

# Interim release-build marker: when exactly '1', the at-rest encryption start-up check treats the install as a release, and muster-api caps the one-time initial password at a single read.
# owner BHD; scope all; optional; read by ces-shared, muster-api
# Default: off (developer build)
# Allowed: '1' = release build; anything else = developer build
# CES_RELEASE_BUILD=

# When '1' or 'true', loading a tenant record refuses literal values in auth.cert_thumbprint and evidence_storage.account_key and requires env: references instead.
# owner operator; scope all; optional; read by ces-shared, ces-tenant
# Default: off
# Allowed: '1' or 'true' = on; anything else = off
# CES_STRICT_SECRETS=

# ===== ces-stamper =====

# Bearer token Stamper's API adapter adds as the Authorization header on outgoing HTTP calls made by plan tasks, unless the task already sets one.
# owner operator; scope all; optional
# Secret: see secrets.inventory.yaml (API_BEARER_TOKEN). Never write the value here.
API_BEARER_TOKEN=

# Entra app (client) ID Stamper uses for certificate sign-in to the tenant, read from the environment or Stamper's .env file (dotenv).
# owner operator; scope all; optional
# Default: ''
# Allowed: an Entra application (client) ID GUID
# APP_ID=

# Overrides the Azure sign-in authority URL Stamper uses; by default it is derived from the active cloud stack's login endpoint plus '/organizations'.
# owner operator; scope live; optional
# Default: <stack login endpoint>/organizations (from the active stack provider)
# Allowed: an https URL
# AZURE_AUTH_ENDPOINT=

# Path to the tenant certificate file Stamper uses for app sign-in, read from the environment or Stamper's .env file.
# owner operator; scope all; optional
# Default: ''
# Allowed: a file path to the tenant certificate (.pfx)
# CERT_PATH=

# Thumbprint of the tenant certificate Stamper signs in with (identifies the key in the Windows certificate store; not itself a secret), read from the environment or Stamper's .env file.
# owner operator; scope all; optional
# Default: ''
# Allowed: a 40-hex-character certificate thumbprint
# CERT_THUMBPRINT=

# How long Stamper's GUI cost gate waits for the operator's second confirmation (DP-2) on a recurring-cost step before giving up.
# owner operator; scope all; optional
# Default: 600000 (10 minutes)
# Allowed: a positive number of milliseconds; anything else = default
# CES_COST_DP2_TIMEOUT_MS=

# Releases the held standing grants: only when exactly 'true' do tenant bootstrap and the Stamper preflight check or grant SharePoint Sites.FullControl.All and the held directory roles (held pending a BHD decision; CES never sets it).
# owner BHD; scope all; optional
# Default: off
# Allowed: 'true' = on; anything else = off
# CES_HELD_STANDING_GRANTS_ENABLED=

# Bearer token Stamper sends to muster-api's POST /api/plan/secrets/resolve to fetch one-time secret values such as the initial password; muster-api checks it as a session JWT signed with JWT_SECRET for an operator role, so it must be a minted muster-api JWT, not a random value; read through secretEnv(): a DPAPI store value wins over the environment.
# owner contractor; scope all; optional
# Secret: see secrets.inventory.yaml (CES_MUSTER_SECRETS_TOKEN). Never write the value here.
CES_MUSTER_SECRETS_TOKEN=

# Base URL of muster-api from which the Stamper command line resolves a plan's one-time operator-held secret references; unset means nothing is fetched and tasks needing those secrets stop.
# owner contractor; scope all; optional
# Default: unset = no secret references fetched
# Allowed: http(s) base URL of muster-api
# CES_MUSTER_SECRETS_URL=

# Bearer token the Stamper GUI server requires on API calls; read through secretEnv(): a DPAPI store value wins over the environment.
# owner contractor; scope all; optional
# Secret: see secrets.inventory.yaml (CES_STAMPER_AUTH_TOKEN). Never write the value here.
CES_STAMPER_AUTH_TOKEN=

# Points Stamper's dev plan-data folder (and the translate route's 'dev' tenant plans) at another root, used by test runs for a run-scoped folder.
# owner contractor; scope dev; optional
# Default: <Stamper repo root>\plan-data
# Allowed: directory path
# CES_STAMPER_PLAN_DATA_ROOT=

# Selects which Stamper console the GUI server serves at / : 'react' for the React app, otherwise the legacy console (the SPA stays at /app/).
# owner contractor; scope all; optional
# Default: legacy
# Allowed: 'react' = React SPA; anything else = legacy console
# CES_STAMPER_UI=

# Customer display name that Stamper puts into its config and the execution context variable clientName (used in plan text and console output).
# owner operator; scope all; optional
# Default: a hard-coded customer display name (see source)
# Allowed: free text
# CLIENT_NAME=

# Security and Compliance PowerShell connection URI that Stamper's IPPS adapter passes to Connect-IPPSSession when GCC High endpoints are on.
# owner operator; scope live; optional
# Default: the active stack provider's compliance endpoint
# Allowed: an https URI
# COMPLIANCE_URI=

# Puts Stamper in dry-run mode (no tenant changes, and TENANT_ID/APP_ID/CERT_THUMBPRINT are not required); the CLI also sets it itself for --dry-run, --dev and translate --execute.
# owner operator; scope all; optional
# Default: unset = live execution
# Allowed: exactly 'true' = dry run; anything else = off
# DRY_RUN=

# Lets Stamper's rollback handler undo completed tasks after a failure; on unless set to exactly 'false'.
# owner operator; scope all; optional
# Default: on
# Allowed: exactly 'false' = off; anything else = on
# ENABLE_ROLLBACK=

# Folder where Stamper writes execution evidence.
# owner operator; scope all; optional
# Default: <STORAGE_ROOT>\evidence (Stamper module storage)
# Allowed: a folder path
# EVIDENCE_DIR=

# Exchange Online environment name Stamper uses when connecting to Exchange.
# owner operator; scope live; optional
# Default: the active stack provider's Exchange environment name
# Allowed: an Exchange Online environment name
# EXCHANGE_ENV=

# Makes Stamper use the GCC High connection forms (for example the IPPS ConnectionUri and the GCC High PowerShell connect path).
# owner operator; scope live; optional
# Default: unset = off
# Allowed: exactly 'true' = on; anything else = off
# GCC_HIGH_ENDPOINTS=

# Microsoft Graph endpoint Stamper uses for its tenant connection.
# owner operator; scope live; optional
# Default: the active stack provider's Graph endpoint (dotenv loader: https://graph.microsoft.us)
# Allowed: an https URL
# GRAPH_ENDPOINT=

# Lets Stamper's idempotency guard skip tasks already applied; on unless set to exactly 'false'.
# owner operator; scope all; optional
# Default: on
# Allowed: exactly 'false' = off; anything else = on
# IDEMPOTENCY_CHECK=

# Azure region for Stamper's CLI dotenv loader; only when SUBSCRIPTION_ID, RESOURCE_GROUP and LOCATION are all set does it add a subscription block to the tenant config.
# owner operator; scope live; optional
# Allowed: an Azure region name
# LOCATION=

# Folder Stamper uses for its logs.
# owner operator; scope all; optional
# Default: <STORAGE_ROOT>\logs (Stamper module storage)
# Allowed: a folder path
# LOG_DIR=

# UNCLEAR: Stamper stores this as config.logLevel (default 'info'), but no code outside StamperConfig.ts reads logLevel.
# owner operator; scope all; optional
# Allowed: free text
# LOG_LEVEL=info

# Entra login authority Stamper uses; the Azure auth endpoint default is derived from it.
# owner operator; scope live; optional
# Default: the active stack provider's login endpoint (dotenv loader: https://login.microsoftonline.us)
# Allowed: an https URL
# LOGIN_ENDPOINT=

# Azure resource group for the Stamper CLI's dotenv tenant config; the subscription block is set only when SUBSCRIPTION_ID, RESOURCE_GROUP and LOCATION are all present.
# owner operator; scope live; optional
# Allowed: Azure resource group name
# RESOURCE_GROUP=

# When exactly '1', the Stamper CLI run from dist only warns when dist is older than src instead of refusing to run.
# owner contractor; scope dev; optional
# Default: unset = refuse
# Allowed: '1' = warn and continue; anything else = refuse
# STAMPER_ALLOW_STALE_DIST=

# Evidence directory Stamper's evidence-readiness analyzer reads, fixed at module load.
# owner contractor; scope all; optional
# Default: {CES_PIPELINE_ROOT}\Stamper\plan-data\dev\evidence
# Allowed: directory path
# STAMPER_EVIDENCE_DIR=

# Stamper CLI fills the plan's unresolved initialPassword variable from this variable into the in-memory secret overlay (redacted in logs and evidence).
# owner contractor; scope dev; optional
# Secret: see secrets.inventory.yaml (STAMPER_INITIAL_PASSWORD). Never write the value here.
STAMPER_INITIAL_PASSWORD=

# Directory Stamper keeps its run state in.
# owner contractor; scope all; optional
# Default: {STORAGE_ROOT}\state
# Allowed: directory path
# STATE_DIR=

# Azure subscription id for the Stamper CLI's dotenv tenant config; the subscription block is set only when SUBSCRIPTION_ID, RESOURCE_GROUP and LOCATION are all present.
# owner operator; scope live; optional
# Allowed: Azure subscription id (GUID)
# SUBSCRIPTION_ID=

# Tenant domain in the Stamper CLI's dotenv tenant config (dotenv loader, CLI bootstrap only).
# owner operator; scope live; optional
# Default: a hard-coded customer onmicrosoft.us domain
# Allowed: tenant primary domain
# TARGET_TENANT_DOMAIN=

# Entra tenant id in Stamper's config when it is not taken from a tenant record.
# owner operator; scope live; optional
# Default: ""
# Allowed: Entra tenant id (GUID)
# TENANT_ID=

# ===== ces-tenant =====

# Bearer token of the optional ces-tenant service daemon (npm run serve): the daemon requires it on /api/* and /status from network callers, and the ces-tenant client sends it when set; read from the process environment.
# owner contractor; scope all; optional
# Secret: see secrets.inventory.yaml (CES_TENANT_AUTH_TOKEN). Never write the value here.
CES_TENANT_AUTH_TOKEN=

# Address the optional ces-tenant service daemon listens on; unset or empty listens on every interface (CES_TENANT_AUTH_TOKEN gates network callers), any other value binds that one address.
# owner operator; scope all; optional
# Default: 'all' (every interface)
# Allowed: 'all' or one listen address (IP or hostname)
# CES_TENANT_BIND=

# Base URL that ces-tenant clients use to reach the tenant service daemon (auth-state-only mode); unset means the loopback default on port 4690.
# owner operator; scope all; optional
# Allowed: an http(s) base URL
# CES_TENANT_SERVICE_URL=http://127.0.0.1:4690

# Microsoft Graph base URL used by muster-api's Graph client and by ces-tenant's legacy env-fallback key provider; the tester points it at the simulator.
# owner operator; scope all; optional; read by ces-tenant, muster-api
# Default: https://graph.microsoft.us/v1.0 (muster-api); the GCC High Graph endpoint (ces-tenant)
# Allowed: an https base URL
# GRAPH_BASE_URL=

# App id for ces-tenant's legacy env fallback, used only when a caller passes no tenant slug; with GRAPH_TENANT_ID unset as well the provider reports degraded.
# owner operator; scope live; optional
# Allowed: an Entra application (client) id
# GRAPH_CLIENT_ID=

# Tenant id for ces-tenant's legacy env fallback, used only when a caller passes no tenant slug; with GRAPH_CLIENT_ID unset as well the provider reports degraded.
# owner operator; scope live; optional
# Allowed: an Entra tenant id
# GRAPH_TENANT_ID=

# Root of the tenant-stacksim checkout, whose psmodules and azshim folders muster-api and ces-tenant put on the PowerShell path for simulator sessions.
# owner contractor; scope sim; optional; read by ces-tenant, muster-api
# Default: the tenant-stacksim folder beside the CES modules (resolved from the module location)
# Allowed: path to the tenant-stacksim checkout
# STACKSIM_ROOT=

# ===== ces-tester =====

# Port for the second EC the tester's FIN-29 E9 scenario starts (set it when 4013 is in use).
# owner contractor; scope dev; optional
# Allowed: a TCP port number
# CES_E9_EC_PORT=4013

# Port for the second EO the tester's FIN-29 E9 scenario starts (set it when 4012 is in use).
# owner contractor; scope dev; optional
# Allowed: a TCP port number
# CES_E9_EO_PORT=4012

# Test-harness switch: on unless exactly '0', the muster e2e run captures the E7B pipeline-root and EO state (ces.db backup plus store copies) so the watched EO run starts from it.
# owner contractor; scope dev; optional
# Default: on
# Allowed: '0' = off; anything else = on
# CES_EU_EO_E7B_STATE=

# Test-harness switch: on unless exactly '0', the UI e2e run has EO assess each variant's own pipeline root after the ledger snapshot (skipped and recorded if port 4002 is held).
# owner contractor; scope dev; optional
# Default: on
# Allowed: '0' = off; anything else = on
# CES_EU_EO_PROBE=

# Test-harness switch: exactly '0' skips the FIN-29 E0 leg (clean-g5 simulator profile check) of the Stamper proof flow.
# owner contractor; scope dev; optional
# Default: on
# Allowed: '0' = skip; anything else = run
# CES_FIN29_E0=

# Test-harness list of scenarios on which the FIN-29 E8G leg (Stamper GUI leg) runs.
# owner contractor; scope dev; optional
# Allowed: comma-separated scenario slugs
# CES_FIN29_E8G_SCENARIOS=s3-def

# Test-harness switch: exactly '0' skips the FIN-29 E8R leg (Stamper lifecycle commands on a private pipeline root).
# owner contractor; scope dev; optional
# Default: on
# Allowed: '0' = skip; anything else = run
# CES_FIN29_E8R=

# Test-harness list of scenarios on which the FIN-29 E8T leg (Stamper terminal leg in a pseudo-console) runs.
# owner contractor; scope dev; optional
# Allowed: comma-separated scenario slugs
# CES_FIN29_E8T_SCENARIOS=s2-eng

# Set to 'center' by the ces-tester Command Center on the child it launches so the CLI wrapper does not record a second run-index entry; not set by people.
# owner contractor; scope dev; optional
# Default: unset = CLI run records itself
# Allowed: 'center' = launched by the tester Command Center
# CES_LAUNCHED_BY=

# Test-harness switch: on unless exactly '0', the muster e2e run posts the customer's NS-3 personnel, screening, training, risk and offboarding records to EO.
# owner contractor; scope dev; optional
# Default: on
# Allowed: '0' = off; anything else = on
# CES_NS3_EO_RECORDS=

# Overrides where ces-tester finds the CES workspace root (the folder containing ces-muster and ces-stamper).
# owner contractor; scope dev; optional
# Default: found by walking up from cwd to the folder holding ces-muster and ces-stamper
# Allowed: directory path
# CES_ROOT=

# Run id the ces-tester Command Center hands to a launched child so the CLI reuses it in the run index instead of minting its own.
# owner contractor; scope dev; optional
# Default: cli-<epoch ms>
# Allowed: run id string
# CES_RUN_ID=

# Output path of the throwaway simulator certificate that ces-tester's AO step passes to its PowerShell child; set by the harness itself.
# owner contractor; scope sim; optional
# Default: <out>/ao/sim/<slug>.pfx
# Allowed: set internally
# CES_SIM_PFX_OUT=

# Random per-run password for the throwaway simulator PFX, passed only in the PowerShell child's environment by ces-tester's AO step and then dropped.
# owner contractor; scope sim; optional
# Secret: see secrets.inventory.yaml (CES_SIM_PFX_PASSWORD). Never write the value here.
CES_SIM_PFX_PASSWORD=

# Output folder for the tester's Muster plan-generator CLI; the CLI throws unless FT_PLAN_CASE, FT_OUT_DIR and FT_SLUG are all set.
# owner contractor; scope dev; required
# Allowed: a folder path
FT_OUT_DIR=

# Path of the plan-case JSON that the tester's Muster plan-generator CLI turns into a plan.
# owner contractor; scope dev; required
# Allowed: a path to a MusterPlanCase JSON file
FT_PLAN_CASE=

# Tenant slug the tester's Muster plan-generator CLI writes the plan for.
# owner contractor; scope dev; required
# Allowed: a tenant slug
FT_SLUG=

# Lets the tester's e2e overrides gate accept the simulator override file only when exactly '1'.
# owner contractor; scope dev; optional
# Default: unset = off
# Allowed: '1' = on; anything else = off
# MX_ALLOW_OVERRIDES=

# ===== muster-api =====

# Model-API key for muster-api's AI paths; AI runs only when this is set AND MUSTER_LIVE_CLIENT_ID is empty AND MUSTER_AI_SIM_ONLY is exactly '1', so it is never used with live tenant access.
# owner BHD; scope dev; optional
# Secret: see secrets.inventory.yaml (ANTHROPIC_API_KEY). Never write the value here.
ANTHROPIC_API_KEY=

# Path to the ces-muster SPA root (holding scripts/mx and vite-node) that muster-api uses to run the plan compiler.
# owner contractor; scope all; optional
# Default: the ces-muster folder (three levels above muster-api's service file)
# Allowed: directory path
# CES_MUSTER_ROOT=

# Anthropic model id used by muster-api's AI coach and adaptive-interview services, which only run when the AI gate allows (sim-only declared, no live access configured, key present).
# owner BHD; scope sim; optional
# Allowed: an Anthropic model id
# CLAUDE_MODEL=claude-opus-4-8

# Fallback source URL for the one-off engagementMigrate export command, which copies every table out of a legacy PostgreSQL database with psql into JSON files (the --url flag wins); no server reads it.
# owner operator; scope dev; optional
# Secret: see secrets.inventory.yaml (DATABASE_URL). Never write the value here.
DATABASE_URL=

# Lifetime of the user session JWTs that muster-api mints.
# owner operator; scope all; optional
# Allowed: a jsonwebtoken expiresIn value (for example '8h', '30m')
# JWT_EXPIRES_IN=8h

# HS256 secret that signs and verifies muster-api user session JWTs; read through secretEnv(), so a DPAPI store value wins over the environment, and muster-api refuses to start without it.
# owner contractor; scope all; required
# Secret: see secrets.inventory.yaml (JWT_SECRET). Never write the value here.
JWT_SECRET=

# Base URL the mu command-line client calls when --api-url is not given.
# owner contractor; scope all; optional
# Allowed: muster-api base URL; the --api-url flag wins
# MU_API_URL=http://localhost:4000

# Login email for 'mu login' when --email is not given; login fails without an email from the flag or this variable.
# owner contractor; scope all; optional
# Allowed: a muster-api user email; the --email flag wins
# MU_EMAIL=

# Login password for 'mu login' when --password is not given; login fails without a password from the flag or this variable.
# owner contractor; scope all; optional
# Secret: see secrets.inventory.yaml (MU_PASSWORD). Never write the value here.
MU_PASSWORD=

# muster-api bearer JWT the mu client uses when --token is not given, before falling back to the saved credential file.
# owner contractor; scope all; optional
# Secret: see secrets.inventory.yaml (MU_TOKEN). Never write the value here.
MU_TOKEN=

# Declares this muster-api serves simulated tenants only; the AI routes run only when it is exactly '1', ANTHROPIC_API_KEY is set and MUSTER_LIVE_CLIENT_ID is unset, otherwise they answer 503 degraded.
# owner operator; scope sim; optional
# Default: unset = AI off
# Allowed: exactly '1' = declared sim-only; anything else = not
# MUSTER_AI_SIM_ONLY=

# Browser origins muster-api returns CORS headers for; any other origin gets none, so the browser blocks it.
# owner operator; scope all; optional
# Allowed: comma-separated origins
# MUSTER_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Delegated access token that muster-api puts only into the environment of each live-discovery PowerShell child (Exchange, Purview, Azure, Teams connects); never set by hand.
# owner operator; scope live; optional
# Secret: see secrets.inventory.yaml (MUSTER_LIVE_AREA_TOKEN). Never write the value here.
MUSTER_LIVE_AREA_TOKEN=

# Azure environment name muster-api's live discovery passes to Connect-AzAccount.
# owner operator; scope live; optional
# Allowed: an Az PowerShell environment name
# MUSTER_LIVE_AZ_ENVIRONMENT=AzureUSGovernment

# ARM Microsoft.Authorization/permissions api-version muster-api uses when checking live Azure access (marked unconfirmed for GCC High in code).
# owner operator; scope live; optional
# Allowed: an ARM api-version string
# MUSTER_LIVE_AZ_PERMISSIONS_API_VERSION=2022-04-01

# Public client id for muster-api's device-code consent used by live discovery and harvest; live consent fails with not_configured when unset, and when set the AI routes are refused.
# owner operator; scope live; optional
# Default: unset = live access not configured
# Allowed: a public Entra client id (device-code flow, no secret)
# MUSTER_LIVE_CLIENT_ID=

# Exchange environment name muster-api's live discovery passes to Connect-ExchangeOnline.
# owner operator; scope live; optional
# Allowed: an ExchangeEnvironmentName value
# MUSTER_LIVE_EXO_ENVIRONMENT=O365USGovGCCHigh

# Entra role template id muster-api requires the consenting live user to hold (Global Reader); other roles held alongside are not refused.
# owner operator; scope live; optional
# Default: the Entra built-in Global Reader role template id (see source)
# Allowed: an Entra role template id
# MUSTER_LIVE_GLOBAL_READER_ROLE_ID=

# Graph PowerShell environment muster-api's live discovery passes to Connect-MgGraph.
# owner operator; scope live; optional
# Allowed: a Microsoft Graph PowerShell environment name
# MUSTER_LIVE_GRAPH_ENVIRONMENT=USGov

# Delegated Graph access token that muster-api puts only into the environment of the live-discovery PowerShell child for Connect-MgGraph and Teams; never set by hand.
# owner operator; scope live; optional
# Secret: see secrets.inventory.yaml (MUSTER_LIVE_GRAPH_TOKEN). Never write the value here.
MUSTER_LIVE_GRAPH_TOKEN=

# Overrides the -AzureADAuthorizationEndpointUri that muster-api's live Purview discovery passes to Connect-IPPSSession.
# owner operator; scope live; optional
# Default: https://login.microsoftonline.us/<consented tenant id>
# Allowed: an Entra authorization endpoint URL
# MUSTER_LIVE_IPPS_AUTH_URI=

# Overrides the -ConnectionUri that muster-api's live Purview discovery passes to Connect-IPPSSession (default is the GCC High endpoint).
# owner operator; scope live; optional
# Allowed: a Security & Compliance PowerShell connection URL
# MUSTER_LIVE_IPPS_CONNECTION_URI=https://ps.compliance.protection.office365.us/powershell-liveid/

# Login authority base URL muster-api uses for live device-code consent sign-ins, when the live-access config does not set one.
# owner operator; scope live; optional
# Allowed: login authority base URL; trailing slashes are stripped
# MUSTER_LIVE_LOGIN_BASE=https://login.microsoftonline.us

# Starts muster-api's background scheduler (nudges and reminders to the simulated mail outbox) unless set to 'off'; the POST /tick routes work either way.
# owner operator; scope all; optional
# Default: on
# Allowed: 'off' (any case) = scheduler not started; anything else = on
# MUSTER_SCHEDULER=

# Path of the discovery verdict-predicate data file that muster-api's discovery service reads in place.
# owner contractor; scope all; optional
# Default: ces-muster/src/features/discovery/verdictPredicates.json (resolved from the muster-api module location)
# Allowed: path to a verdict-predicates JSON file
# MUSTER_VERDICT_PREDICATES=

# TCP port muster-api listens on.
# owner operator; scope all; optional
# Allowed: integer TCP port
# PORT=4000

# Number of days after an assessment before muster-api's reassessment service treats it as due for reassessment.
# owner operator; scope all; optional
# Allowed: integer days
# REASSESS_DAYS=365

# Directory muster-api loads signed recipes from.
# owner contractor; scope all; optional
# Default: ces-muster/recipes (resolved from the muster-api module location)
# Allowed: directory path
# RECIPES_DIR=

# When exactly 'true', POST /api/recipes/ingest no longer needs the 'x-concierge-session: true' header; off keeps recipe ingest behind concierge-assisted validation.
# owner BHD; scope all; optional
# Default: unset = off
# Allowed: 'true' = on; anything else = off
# RECIPES_SELF_SERVE=

# Tick interval of muster-api's background scheduler; the first tick fires one interval after start.
# owner operator; scope all; optional
# Allowed: integer milliseconds
# SCHEDULER_INTERVAL_MS=3600000

# Limits muster-api's background scheduler to one tenant id; unset or empty runs it for every tenant.
# owner operator; scope all; optional
# Default: unset = every tenant
# Allowed: a muster-api tenant id
# SCHEDULER_TENANT_ID=

# Password the muster-api seed script hashes (bcrypt) for the operator user it creates or updates when --password is not given; the script exits without a password.
# owner contractor; scope dev; optional
# Secret: see secrets.inventory.yaml (SEED_PASSWORD). Never write the value here.
SEED_PASSWORD=

# Folder of Stamper command registries muster-api reads for discovery wiring and simulator discovery runs.
# owner contractor; scope all; optional
# Default: ces-stamper/src/registry (resolved from the muster-api module location)
# Allowed: directory path
# STAMPER_REGISTRY_ROOT=

# ===== tenant-stacksim =====

# Path to the ces-eo package that the stacksim verify-doc command passes to its child runner script so it can import EO's real source; set by the command itself, not by a person.
# owner contractor; scope sim; optional
# Allowed: absolute path to the ces-eo package
# CES_EO_ROOT=

# Pins the simulator's seed anchor time so seeded data has fixed dates; unset or empty uses the current clock.
# owner contractor; scope sim; optional
# Default: unset = live clock
# Allowed: ISO date-time; an unparseable value throws
# STACKSIM_FIXED_NOW=

# Legend: owner = who sets the value (BHD, contractor or operator); scope = where it applies
# (dev, sim = simulator, live = a real tenant, all); required/optional = whether the code needs it set.
