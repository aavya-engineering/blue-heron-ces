# ==============================================================================
# Blue Heron CES — Docker Environment Configuration (with SSL & sslip.io)
# ==============================================================================

# ── Service Host Ports ────────────────────────────────────────────────────────
HTTPS_PORT=443
UI_PORT=5173
HTTP_PORT=8080
API_PORT=4000
POSTGRES_PORT=5434
TENANT_PORT=4690
STACKSIM_PORT=4390
STAMPER_PORT=5002

# ── SSL & sslip.io Domain ─────────────────────────────────────────────────────
# By default, points to 127.0.0.1.sslip.io (resolves to localhost).
# When deploying to a server with public or LAN IP (e.g., 54.21.32.11 or 192.168.1.50):
# Set SSLIP_DOMAIN=54.21.32.11.sslip.io
SSLIP_DOMAIN=127.0.0.1.sslip.io
HOST_IP=

# ── PostgreSQL Credentials ────────────────────────────────────────────────────
POSTGRES_DB=muster_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
DB_USER=muster_app
DB_PASSWORD=password

# ── Security & Authentication ─────────────────────────────────────────────────
JWT_SECRET=bhd-ces-muster-local-dev-jwt-secret-key-32chars
JWT_EXPIRES_IN=8h
MUSTER_CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost:8080,https://127.0.0.1.sslip.io,http://127.0.0.1.sslip.io,*.sslip.io

# ── AI / Anthropic Claude Integration (Optional) ─────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ── Pipeline Storage ──────────────────────────────────────────────────────────
CES_PIPELINE_ROOT=/app/pipeline
RECIPES_SELF_SERVE=false
